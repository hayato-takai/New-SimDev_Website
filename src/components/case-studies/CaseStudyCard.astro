---
import { Image } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';
import type { CaseStudy } from '../../lib/caseStudies';

interface Props {
  entry: CaseStudy;
}

const { entry } = Astro.props;
const { data } = entry;
const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');
const preview = data.preview;
---

<a class="cs-card" href={`${BASE_PATH}/case-studies/${entry.id}`}>
  <div class="cs-card__media">
    {preview ? (
      <Image src={preview.src} alt={preview.alt} widths={[400, 800]} sizes="(max-width: 720px) 100vw, 400px" />
    ) : (
      <ImagePlaceholder label="Preview image" />
    )}
  </div>

  <div class="cs-card__body">
    {data.draft && <span class="cs-card__draft">Draft</span>}
    <h2 class="cs-card__title">{data.title}</h2>
    <p class="cs-card__summary">{data.summary}</p>

    <p class="cs-card__headline">
      <strong>{data.headline.value}</strong>
      {data.headline.label}
    </p>

    <p class="cs-card__meta">
      {[data.industry, data.filter && `Air-X ${data.filter}`].filter(Boolean).join(' · ')}
    </p>
  </div>
</a>

<style>
  /* The whole card is the link. The global link colour and hover underline
     are reset so the card's own text colours hold; the title taking the
     accent colour and a lifted shadow are the hover cue. */
  .cs-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: var(--transition-lift), border-color var(--duration-fast) var(--ease-standard);
  }

  .cs-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-lift);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .cs-card:hover .cs-card__title {
    color: var(--accent);
  }

  /* The preview fills a 4:3 frame, cropped to fit, the same as in the page
     banner. overflow:hidden holds the frame at 4:3: in the card's flex
     column a visible-overflow box would grow to the image's own height. */
  .cs-card__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .cs-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cs-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
  }

  .cs-card__draft {
    align-self: flex-start;
    padding: 2px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 12px;
  }

  .cs-card__title {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
    transition: var(--transition-color);
  }

  .cs-card__summary {
    margin: 0;
    color: var(--text-2);
    font-size: 14px;
  }

  /* margin-top:auto parks the result and meta at the bottom, so they line up
     across a row of cards whatever the summary length. */
  .cs-card__headline {
    margin: auto 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    color: var(--text-2);
    font-size: 14px;
  }

  .cs-card__headline strong {
    margin-right: 4px;
    color: var(--accent);
    font-size: 20px;
    font-weight: 700;
  }

  .cs-card__meta {
    margin: 0;
    color: var(--text-muted);
    font-size: 13px;
  }
</style>
