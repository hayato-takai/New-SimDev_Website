---
/**
 * Baseline tank vs. concept tank: the two images side by side (placeholders
 * until they are added), then one bar for oil volume. The bar's grey track
 * ends at the baseline (the dark marker) and the red fill is the concept, so
 * a reduction leaves the saved share of the track empty. If the concept is
 * the larger, the fill runs the full width and the marker sits where the
 * baseline ends.
 */
import { Image } from 'astro:assets';
import ImagePlaceholder from './ImagePlaceholder.astro';
import { formatValue, resultChange, type CaseStudy, type Comparison } from '../../lib/caseStudies';

interface Props {
  images: CaseStudy['data']['images'];
  oilVolume: Comparison;
}

const { images, oilVolume } = Astro.props;

const tanks = [
  { key: 'baseline', label: 'Baseline tank', image: images.baseline },
  { key: 'concept', label: 'Concept tank', image: images.concept }
];

const max = Math.max(oilVolume.baseline, oilVolume.concept) || 1;
const share = (value: number) => `${((value / max) * 100).toFixed(2)}%`;
const change = resultChange(oilVolume);
---

<div class="tc-tanks">
  {tanks.map((tank) => (
    <figure class={`tc-tank is-${tank.key}`}>
      <div class="tc-tank__frame">
        {tank.image ? (
          <Image src={tank.image.src} alt={tank.image.alt} widths={[480, 960]} sizes="(max-width: 520px) 100vw, 560px" />
        ) : (
          <ImagePlaceholder label={`${tank.label} image`} />
        )}
      </div>
      <figcaption>
        <span class="tc-key" aria-hidden="true"></span>
        {tank.label}
      </figcaption>
    </figure>
  ))}
</div>

<div class="tc-bar-card">
  <div class="tc-bar-card__head">
    <h3>Oil volume</h3>
    {change && <span class="tc-change">{change}</span>}
  </div>

  <div class="tc-bar" aria-hidden="true">
    <span class="tc-bar__fill" style={`width: ${share(oilVolume.concept)}`}></span>
    <span class="tc-bar__baseline" style={`left: ${share(oilVolume.baseline)}`}></span>
  </div>

  <dl class="tc-values">
    <div class="is-concept">
      <dt>
        <span class="tc-key" aria-hidden="true"></span>
        Concept tank
      </dt>
      <dd>{formatValue(oilVolume, oilVolume.concept)}</dd>
    </div>
    <div class="is-baseline">
      <dt>
        <span class="tc-key" aria-hidden="true"></span>
        Baseline tank
      </dt>
      <dd>{formatValue(oilVolume, oilVolume.baseline)}</dd>
    </div>
  </dl>
</div>

<style>
  /* Baseline dark and concept red, the report's colours for the two designs. */
  .tc-tanks,
  .tc-bar-card {
    --tc-baseline: #1d1d1f;
    --tc-concept: #d9000d;
  }

  /* ---------- Tank images ---------- */
  .tc-tanks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }

  .tc-tank {
    margin: 0;
  }

  /* Tank images are often CAD on white and vary in shape, so each sits whole
     (contain) in a matching 4:3 frame rather than being cropped. */
  .tc-tank__frame {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .tc-tank__frame img {
    display: block;
    width: 100%;
    height: 100%;
    padding: 16px;
    object-fit: contain;
  }

  .tc-tank figcaption {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 15px;
    font-weight: 700;
  }

  /* Colour keys, shared by the captions and the bar labels. */
  .tc-key {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }

  .is-baseline .tc-key {
    background: var(--tc-baseline);
  }

  .is-concept .tc-key {
    background: var(--tc-concept);
  }

  /* ---------- Oil volume bar ---------- */
  .tc-bar-card {
    padding: 20px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .tc-bar-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .tc-bar-card__head h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
  }

  /* An improvement, so the status green, darkened to pass contrast on white. */
  .tc-change {
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.12);
    color: #047857;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .tc-bar {
    position: relative;
    height: 16px;
    border-radius: 999px;
    background: var(--surface-3);
  }

  .tc-bar__fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    border-radius: 999px;
    background: var(--tc-concept);
  }

  /* The baseline marker: a dark tick standing proud of the track, ending on
     the baseline value. */
  .tc-bar__baseline {
    position: absolute;
    top: -5px;
    bottom: -5px;
    width: 3px;
    margin-left: -3px;
    border-radius: 2px;
    background: var(--tc-baseline);
  }

  .tc-values {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 12px 0 0;
  }

  .tc-values > div:last-child {
    text-align: right;
  }

  .tc-values dt {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 13px;
  }

  .tc-values > div:last-child dt {
    justify-content: flex-end;
  }

  .tc-values dd {
    margin: 2px 0 0;
    color: var(--text-2);
    font-size: 20px;
    font-variant-numeric: tabular-nums;
  }

  .tc-values .is-concept dd {
    color: var(--text);
    font-weight: 700;
  }

  @media (max-width: 520px) {
    .tc-tanks {
      grid-template-columns: 1fr;
    }
  }
</style>
