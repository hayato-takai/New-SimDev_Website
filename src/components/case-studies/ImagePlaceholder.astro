---
/**
 * Stand-in for an image that hasn't been added yet. Fills its frame, which
 * sets the size and shape, and names the image it is waiting for.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="placeholder" role="img" aria-label={`${label} (placeholder)`}>
  <svg class="placeholder__icon" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <circle cx="9" cy="10" r="2" />
    <path d="M3.5 17.5l5-5 4 4 3-3 5 5" />
  </svg>
  <span>{label}</span>
</div>

<style>
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    padding: 16px;
    background: repeating-linear-gradient(
      -45deg,
      var(--surface-2),
      var(--surface-2) 10px,
      var(--surface) 10px,
      var(--surface) 20px
    );
    color: var(--text-muted);
    font-size: 14px;
    text-align: center;
  }

  .placeholder__icon {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
</style>
