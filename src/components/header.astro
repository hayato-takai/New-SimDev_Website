---
const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');

/** Page slugs that exist but should not appear in the navbar. */
const HIDDEN_PAGES = ['index', 'filter-technology'];

/** "oil_properties" -> "Oil Properties" */
function cleanName(slug: string): string {
  return slug.replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

/** Turn an `import.meta.glob` result into nav links rooted at `urlPrefix`. */
function toLinks(modules: Record<string, unknown>, urlPrefix: string) {
  return Object.keys(modules)
    .map((path) => path.split('/').pop()!.replace('.astro', ''))
    .filter((slug) => !HIDDEN_PAGES.includes(slug))
    .map((slug) => ({
      url: `${BASE_PATH}${urlPrefix}/${slug}`,
      title: cleanName(slug)
    }));
}

const topLevelLinks = toLinks(import.meta.glob('../pages/*.astro'), '');
const toolLinks = toLinks(import.meta.glob('../pages/tools/*.astro'), '/tools');
---

<header class="site-header">
  <nav class="site-navbar">
    {topLevelLinks.map((link) => (
      <a href={link.url} class="nav-link">{link.title}</a>
    ))}

    <div class="nav-dropdown">
      <button type="button" class="dropdown-trigger">Tools ▼</button>
      <div class="dropdown-content">
        {toolLinks.map((tool) => (
          <a href={tool.url} class="dropdown-link">{tool.title}</a>
        ))}
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    --header-height: 56px;
    --header-bg: #2c3e50;
    --header-fg: #ffffff;
    --header-accent: #c60000;
    --dropdown-bg: #34495e;
    --dropdown-hover-bg: #3d566e;

    /* Holds open the space that the fixed navbar below takes out of flow.
       flex:none keeps that exact height as a flex item in BaseLayout's column. */
    flex: none;
    height: var(--header-height);
  }

  .site-navbar {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 9999;
    height: var(--header-height);

    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding: 0 20px;

    background: var(--header-bg);
    color: var(--header-fg);
    font-family: var(--font-sans);
    font-size: var(--font-ui);
  }

  .nav-link,
  .dropdown-trigger {
    color: var(--header-fg);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .dropdown-trigger:hover {
    color: var(--header-accent);
  }

  /* Strip the UA button styling so the trigger matches the plain nav links. */
  .dropdown-trigger {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }

  .nav-dropdown {
    position: relative;
  }

  .dropdown-content {
    position: absolute;
    /* 1px overlap so the menu survives the pointer crossing the seam. */
    top: calc(100% - 1px);
    left: 0;
    display: none;
    flex-direction: column;
    min-width: 180px;
    padding: 10px 0;
    background: var(--dropdown-bg);
    border-radius: 6px;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.3);
  }

  .nav-dropdown:hover .dropdown-content,
  .nav-dropdown:focus-within .dropdown-content {
    display: flex;
  }

  /* Stated rather than inherited from .site-navbar, so the menu keeps its
     size if the bar's ever changes. */
  .dropdown-link {
    padding: 8px 16px;
    color: var(--header-fg);
    font-size: var(--font-ui);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .dropdown-link:hover {
    background: var(--dropdown-hover-bg);
    color: var(--header-accent);
  }

  @media (max-width: 768px) {
    .site-navbar {
      justify-content: flex-start;
      gap: 12px;
      padding: 0 12px;
    }
  }
</style>
