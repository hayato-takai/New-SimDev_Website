---
import Layout from '../layouts/BaseLayout.astro';

import Podcast from '../components/podcast.astro';
import Banner from '../components/simulation-banner.astro';
import Lineup from '../components/product_lineup.astro';

import Contact from '../components/Contact.astro';
import Signup from '../components/signup.astro';
import Testimony from '../components/testimony.astro';
import TankReduction from '../components/tank-reduction.astro';
import Comparison from '../components/Comparison.astro';
---

<Layout title="Filter Deaeration Analysis">
  <main>
    <!-- <Signup /> -->
    <!-- <Banner /> -->
    <h1>Filter Deaeration Analysis</h1>

    <Comparison />
    <TankReduction />
    <Lineup />
    <Podcast />
    <!-- <Testimony /> -->
    <Contact />
  </main>
</Layout>

<style>
  /* The heading sits directly in <main>, which has no container of its own, so
     it was left-aligned and flush to the viewport edge. Centred inside the site
     container, matching the gutters the sections below it use.
     global.css already gives headings text-wrap: balance, which keeps the two
     halves even if it ever wraps. */
  h1 {
    width: min(var(--max-width), 100% - var(--gutter) * 2);
    margin: 60px auto 0;
    text-align: center;
  }
</style>
