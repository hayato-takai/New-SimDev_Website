---
/**
 * The list of tool READMEs. Also where old links to the previous viewer
 * (/helpers/documentation?readme=…) now land: the query is ignored.
 */
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/readmeViewer.astro';

const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');

const docs = await Promise.all(
  (await getCollection('docs')).map(async (entry) => {
    const { headings } = await render(entry);
    return { id: entry.id, title: headings.find((h) => h.depth === 1)?.text ?? entry.id };
  })
);
docs.sort((a, b) => a.title.localeCompare(b.title));
---

<Layout title="Documentation">
  <!-- .markdown-body on the full-width wrapper, so the theme background
       covers the whole page in dark mode, not just the column. -->
  <div class="markdown-body doc-index-page">
    <main class="doc-index">
      <h1>Documentation</h1>
      <ul>
        {docs.map((doc) => (
          <li>
            <a href={`${BASE_PATH}/helpers/documentation/${doc.id}`}>{doc.title}</a>
          </li>
        ))}
      </ul>
    </main>
  </div>
</Layout>

<style>
  .doc-index-page {
    min-height: 100vh;
  }

  .doc-index {
    box-sizing: border-box;
    max-width: 900px;
    margin: 0 auto;
    padding: 32px 16px 48px;
  }
</style>
