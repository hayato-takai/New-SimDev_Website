---
import Layout from '../../layouts/BaseLayout.astro';

const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="MP Media Calculator">
<main class="mp-calc tool-page">
<div class="tool-shell">

<!-- Arrowhead and hatch shared by both measurement diagrams. Kept outside the
     tab panels so the references still resolve while a panel is hidden, and
     inside .mp-calc so the var() colours below resolve against the tool
     palette. Sized to nothing rather than display:none, which can break
     paint-server references in some engines. -->
<svg aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
  <defs>
    <marker id="mpDimArrow" viewBox="0 0 10 10" refX="9" refY="5"
            markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="var(--muted, #6e6e73)"/>
    </marker>
    <pattern id="mpHatch" width="7" height="7" patternUnits="userSpaceOnUse"
             patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="7"
            stroke="var(--line-strong, #c8cfd8)" stroke-width="2.5"/>
    </pattern>
  </defs>
</svg>

<header class="tool-header">
  <div class="tool-header-row">
    <h1>MP Media Calculator</h1>
    <a
      class="btn-docs"
      href={`${BASE_PATH}/helpers/documentation?readme=${BASE_PATH}/scripts/mp_media/README.md`}
      target="_blank"
      rel="noopener noreferrer"
    >Documentation</a>
  </div>
  <p class="tool-subtitle">
    Size a filter media pack: media area and slit length for Helios or Standard
    pleating, and how many media panels can be cut from a master panel.
  </p>
</header>

<figure class="hero">
    <img
      src={`${BASE_PATH}/images/pleat_types.jpg`}
      alt="Comparison of Standard and HELIOS pleat packs, showing the unobstructed area of incident flow presented by each."
    />
</figure>

<div class="tabs" role="tablist">
  <button class="tab" role="tab" id="tab-helios"   aria-controls="panel-helios"   aria-selected="true">Helios Pleating</button>
  <button class="tab" role="tab" id="tab-standard" aria-controls="panel-standard" aria-selected="false">Standard Pleating</button>
</div>

<!-- ============================ HELIOS ============================ -->
<section id="panel-helios" role="tabpanel" aria-labelledby="tab-helios">

  <div class="tool-card card">
    <h2>Pleat pack inputs</h2>
    <div class="grid">
      <div class="f">
        <label for="h_high">High Pleat <span class="unit">mm</span></label>
        <input type="number" id="h_high" value="11" step="0.1">
      </div>
      <div class="f">
        <label for="h_blocks">Block Count</label>
        <input type="number" id="h_blocks" value="42" step="1">
      </div>
      <div class="f">
        <label for="h_mpw">MP Width <span class="unit">mm</span></label>
        <input type="number" id="h_mpw" value="1200" step="1">
      </div>
    </div>
    <p class="rule" id="h_rule">
      Low Pleat is derived automatically: High Pleat &lt; 16 &rarr; <b>High &minus; 1.3</b>; High Pleat &ge; 16 &rarr; <b>High &minus; 2.0</b>.
    </p>
  </div>

  <div class="tool-card card">
    <h2>Results</h2>
    <div class="outs">
      <div class="out stale"><span class="k">Low Pleat</span><span class="v" id="h_low">---</span><span class="u">mm</span></div>
      <div class="out stale"><span class="k">Total Blocks</span><span class="v" id="h_tblocks">---</span></div>
      <div class="out stale"><span class="k">Media Area</span><span class="v" id="h_area">---</span><span class="u">cm&sup2;</span></div>
      <div class="out stale"><span class="k">Slit Length</span><span class="v" id="h_slit">---</span><span class="u">m</span></div>
    </div>
    <p class="msg" id="h_status" hidden></p>
  </div>

  <div class="tool-card card">
    <h2>MP per MMP <span class="sub">70&nbsp;mm edge allowance</span></h2>
    <div class="grid">
      <div class="f">
        <label for="h_mmpw">MMP Width <span class="unit">mm</span></label>
        <input type="number" id="h_mmpw" value="1100" step="1">
      </div>
      <div class="f">
        <label for="h_packw">MP Width (pack) <span class="unit">mm</span></label>
        <input type="number" id="h_packw" value="64.5" step="0.1">
      </div>
    </div>
    <div class="outs" style="margin-top:16px">
      <div class="out stale"><span class="k">MP Count</span><span class="v" id="h_count">---</span></div>
      <div class="out stale"><span class="k">MP Remainder</span><span class="v" id="h_rem">---</span></div>
    </div>
  </div>

  <div class="tool-card card">
    <h2>What the measurements mean</h2>
    <div class="dia-wrap">
      <svg class="dia" viewBox="0 0 620 520" role="img" aria-labelledby="hDiaT hDiaD">
        <title id="hDiaT">Helios pleat pack measurements</title>
        <desc id="hDiaD">A side view of an alternating high and low pleat pack, drawn with depth so
          the MP width is visible along a fold line, above a strip showing how whole MPs are cut from
          a master media panel after a 70 mm edge allowance.</desc>

        <!-- ============ pleat pack ============ -->
        <text class="dia-head" x="34" y="20">Pleat pack &mdash; side view</text>

        <!-- Pleat faces, painted back-to-front so near folds overlap far ones. -->
        <polygon class="dia-face-b" points="416,150 442,215 538,157 512,92"/>
        <polygon class="dia-face-a" points="390,215 416,150 512,92 486,157"/>
        <polygon class="dia-face-b" points="364,120 390,215 486,157 460,62"/>
        <polygon class="dia-face-a" points="338,215 364,120 460,62 434,157"/>
        <polygon class="dia-face-b" points="312,150 338,215 434,157 408,92"/>
        <polygon class="dia-face-a" points="286,215 312,150 408,92 382,157"/>
        <polygon class="dia-face-b" points="260,120 286,215 382,157 356,62"/>
        <polygon class="dia-face-a" points="234,215 260,120 356,62 330,157"/>
        <polygon class="dia-face-b" points="208,150 234,215 330,157 304,92"/>
        <polygon class="dia-face-a" points="182,215 208,150 304,92 278,157"/>
        <polygon class="dia-face-b" points="156,120 182,215 278,157 252,62"/>
        <polygon class="dia-face-a" points="130,215 156,120 252,62 226,157"/>

        <polyline class="dia-edge"
          points="130,215 156,120 182,215 208,150 234,215 260,120 286,215 312,150 338,215 364,120 390,215 416,150 442,215"/>

        <!-- Extension lines out to the dimension lines -->
        <line class="dia-ext" x1="58"  y1="215" x2="130" y2="215"/>
        <line class="dia-ext" x1="58"  y1="120" x2="156" y2="120"/>
        <line class="dia-ext" x1="94"  y1="150" x2="208" y2="150"/>

        <!-- High Pleat: valley to tall peak -->
        <line class="dia-dim" x1="64" y1="120" x2="64" y2="215"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <text class="dia-label" x="50" y="167" text-anchor="middle"
              transform="rotate(-90 50 167)">High Pleat</text>

        <!-- Low Pleat: valley to short peak. Derived, never typed in. -->
        <line class="dia-dim" x1="100" y1="150" x2="100" y2="215"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <text class="dia-label" x="86" y="182" text-anchor="middle"
              transform="rotate(-90 86 182)">Low Pleat</text>

        <!-- MP Width runs along a fold line, into the depth of the pack -->
        <line class="dia-ext" x1="156" y1="120" x2="148" y2="106"/>
        <line class="dia-ext" x1="252" y1="62"  x2="244" y2="48"/>
        <line class="dia-dim" x1="148" y1="106" x2="244" y2="48"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <text class="dia-label" x="189" y="66" text-anchor="middle"
              transform="rotate(-31 189 66)">MP Width</text>

        <!-- Block Count spans the alternating stack -->
        <line class="dia-ext" x1="130" y1="215" x2="130" y2="258"/>
        <line class="dia-ext" x1="442" y1="215" x2="442" y2="258"/>
        <line class="dia-dim" x1="130" y1="252" x2="442" y2="252"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <text class="dia-label" x="286" y="272" text-anchor="middle">Block Count</text>

        <text class="dia-note" x="286" y="292" text-anchor="middle">One high pleat + one low pleat per block count;</text>
        <text class="dia-note" x="286" y="308" text-anchor="middle">the pack also carries 5 full-height blocks, so Total Blocks = 2B + 5.</text>

        <line class="dia-rule" x1="34" y1="334" x2="586" y2="334"/>

        <!-- ============ MP per MMP ============ -->
        <text class="dia-head" x="34" y="360">Cutting MPs from an MMP</text>

        <line class="dia-ext" x1="60"  y1="388" x2="60"  y2="368"/>
        <line class="dia-ext" x1="560" y1="388" x2="560" y2="368"/>
        <line class="dia-dim" x1="60" y1="374" x2="560" y2="374"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <text class="dia-label" x="310" y="368" text-anchor="middle">MMP Width</text>

        <rect class="dia-allow" x="60"  y="388" width="35"  height="50"/>
        <rect class="dia-band"  x="95"  y="388" width="100" height="50"/>
        <rect class="dia-band"  x="195" y="388" width="100" height="50"/>
        <rect class="dia-band"  x="295" y="388" width="100" height="50"/>
        <rect class="dia-band"  x="395" y="388" width="100" height="50"/>
        <rect class="dia-waste" fill="url(#mpHatch)" x="495" y="388" width="65"  height="50"/>

        <text class="dia-small" x="145" y="417" text-anchor="middle">MP 1</text>
        <text class="dia-small" x="245" y="417" text-anchor="middle">MP 2</text>
        <text class="dia-small" x="345" y="417" text-anchor="middle">MP 3</text>
        <text class="dia-small" x="445" y="417" text-anchor="middle">MP 4</text>

        <line class="dia-ext" x1="60"  y1="438" x2="60"  y2="462"/>
        <line class="dia-ext" x1="95"  y1="388" x2="95"  y2="462"/>
        <line class="dia-ext" x1="195" y1="438" x2="195" y2="462"/>
        <line class="dia-ext" x1="495" y1="438" x2="495" y2="462"/>
        <line class="dia-ext" x1="560" y1="438" x2="560" y2="462"/>

        <line class="dia-dim" x1="60"  y1="456" x2="95"  y2="456"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <line class="dia-dim" x1="95"  y1="456" x2="195" y2="456"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <line class="dia-dim" x1="495" y1="456" x2="560" y2="456"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>

        <text class="dia-small" x="77"  y="476" text-anchor="middle">70 mm</text>
        <text class="dia-label" x="145" y="477" text-anchor="middle">MP Width (pack)</text>
        <text class="dia-small" x="527" y="476" text-anchor="middle">remainder</text>

        <text class="dia-note" x="310" y="502" text-anchor="middle">MP Count is the whole MPs that fit after the 70 mm allowance (4 here). MP Remainder is the leftover fraction.</text>
      </svg>
    </div>
  </div>

</section>

<!-- =========================== STANDARD =========================== -->
<section id="panel-standard" role="tabpanel" aria-labelledby="tab-standard" hidden>

  <div class="tool-card card">
    <h2>Inputs</h2>
    <div class="grid">
      <div class="f">
        <label for="s_height">Pleat Height <span class="unit">mm</span></label>
        <input type="number" id="s_height" value="14.5" step="0.1">
      </div>
      <div class="f">
        <label for="s_count">Pleat Count</label>
        <input type="number" id="s_count" value="53" step="1">
      </div>
      <div class="f">
        <label for="s_mpw">MP Width <span class="unit">mm</span></label>
        <input type="number" id="s_mpw" value="176" step="1">
      </div>
    </div>
  </div>

  <div class="tool-card card">
    <h2>Results by MMP width</h2>
    <div class="scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">&nbsp;</th>
            <th scope="col" class="col-self">Single MP<br><span id="s_selfw" style="font-weight:400">176 mm</span></th>
            <th scope="col">MMP A<br><input type="number" id="s_w1" value="950" step="1" aria-label="MMP width A (mm)"></th>
            <th scope="col">MMP B<br><input type="number" id="s_w2" value="1100" step="1" aria-label="MMP width B (mm)"></th>
            <th scope="col">MMP C<br><input type="number" id="s_w3" value="1200" step="1" aria-label="MMP width C (mm)"></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">MMP Media Area <span class="u">cm&sup2;</span></th>
            <td class="col-self" id="s_area0">---</td>
            <td id="s_area1">---</td><td id="s_area2">---</td><td id="s_area3">---</td>
          </tr>
          <tr>
            <th scope="row">Slit Length <span class="u">m</span></th>
            <td class="col-self" id="s_slit0">---</td>
            <td id="s_slit1">---</td><td id="s_slit2">---</td><td id="s_slit3">---</td>
          </tr>
          <tr>
            <th scope="row">MP Count</th>
            <td class="col-self dash">---</td>
            <td id="s_cnt1">---</td><td id="s_cnt2">---</td><td id="s_cnt3">---</td>
          </tr>
          <tr>
            <th scope="row">Waste <span class="u">mm</span></th>
            <td class="col-self dash">---</td>
            <td id="s_wst1">---</td><td id="s_wst2">---</td><td id="s_wst3">---</td>
          </tr>
          <tr>
            <th scope="row">MP Media Area <span class="u">cm&sup2;</span></th>
            <td class="col-self dash">---</td>
            <td id="s_mpa1">---</td><td id="s_mpa2">---</td><td id="s_mpa3">---</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="msg" id="s_status" hidden></p>
  </div>

  <div class="tool-card card">
    <h2>What the measurements mean</h2>
    <div class="dia-wrap">
      <svg class="dia" viewBox="0 0 620 520" role="img" aria-labelledby="sDiaT sDiaD">
        <title id="sDiaT">Standard pleat pack measurements</title>
        <desc id="sDiaD">A side view of a uniform pleat pack, drawn with depth so the MP width is
          visible along a fold line, above a strip showing how whole MPs are cut from a master media
          panel after a 70 mm edge allowance.</desc>

        <!-- ============ pleat pack ============ -->
        <text class="dia-head" x="34" y="20">Pleat pack &mdash; side view</text>

        <!-- Pleat faces, painted back-to-front so near folds overlap far ones. -->
        <polygon class="dia-face-b" points="416,120 442,215 538,157 512,62"/>
        <polygon class="dia-face-a" points="390,215 416,120 512,62 486,157"/>
        <polygon class="dia-face-b" points="364,120 390,215 486,157 460,62"/>
        <polygon class="dia-face-a" points="338,215 364,120 460,62 434,157"/>
        <polygon class="dia-face-b" points="312,120 338,215 434,157 408,62"/>
        <polygon class="dia-face-a" points="286,215 312,120 408,62 382,157"/>
        <polygon class="dia-face-b" points="260,120 286,215 382,157 356,62"/>
        <polygon class="dia-face-a" points="234,215 260,120 356,62 330,157"/>
        <polygon class="dia-face-b" points="208,120 234,215 330,157 304,62"/>
        <polygon class="dia-face-a" points="182,215 208,120 304,62 278,157"/>
        <polygon class="dia-face-b" points="156,120 182,215 278,157 252,62"/>
        <polygon class="dia-face-a" points="130,215 156,120 252,62 226,157"/>

        <polyline class="dia-edge"
          points="130,215 156,120 182,215 208,120 234,215 260,120 286,215 312,120 338,215 364,120 390,215 416,120 442,215"/>

        <!-- Extension lines out to the dimension lines -->
        <line class="dia-ext" x1="58" y1="215" x2="130" y2="215"/>
        <line class="dia-ext" x1="58" y1="120" x2="156" y2="120"/>

        <!-- Pleat Height: valley to peak, the same for every pleat -->
        <line class="dia-dim" x1="64" y1="120" x2="64" y2="215"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <text class="dia-label" x="50" y="167" text-anchor="middle"
              transform="rotate(-90 50 167)">Pleat Height</text>

        <!-- MP Width runs along a fold line, into the depth of the pack -->
        <line class="dia-ext" x1="156" y1="120" x2="148" y2="106"/>
        <line class="dia-ext" x1="252" y1="62"  x2="244" y2="48"/>
        <line class="dia-dim" x1="148" y1="106" x2="244" y2="48"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <text class="dia-label" x="189" y="66" text-anchor="middle"
              transform="rotate(-31 189 66)">MP Width</text>

        <!-- Pleat Count spans the whole pack -->
        <line class="dia-ext" x1="130" y1="215" x2="130" y2="258"/>
        <line class="dia-ext" x1="442" y1="215" x2="442" y2="258"/>
        <line class="dia-dim" x1="130" y1="252" x2="442" y2="252"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <text class="dia-label" x="286" y="272" text-anchor="middle">Pleat Count &mdash; 6 shown</text>

        <text class="dia-note" x="286" y="294" text-anchor="middle">Both faces of every pleat carry media, so the area is</text>
        <text class="dia-note" x="286" y="310" text-anchor="middle">2 &times; Pleat Height &times; Pleat Count &times; MP Width.</text>

        <line class="dia-rule" x1="34" y1="334" x2="586" y2="334"/>

        <!-- ============ MP per MMP ============ -->
        <text class="dia-head" x="34" y="360">Cutting MPs from an MMP</text>

        <line class="dia-ext" x1="60"  y1="388" x2="60"  y2="368"/>
        <line class="dia-ext" x1="560" y1="388" x2="560" y2="368"/>
        <line class="dia-dim" x1="60" y1="374" x2="560" y2="374"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <text class="dia-label" x="310" y="368" text-anchor="middle">MMP Width &mdash; the A, B and C columns</text>

        <rect class="dia-allow" x="60"  y="388" width="35"  height="50"/>
        <rect class="dia-band"  x="95"  y="388" width="100" height="50"/>
        <rect class="dia-band"  x="195" y="388" width="100" height="50"/>
        <rect class="dia-band"  x="295" y="388" width="100" height="50"/>
        <rect class="dia-band"  x="395" y="388" width="100" height="50"/>
        <rect class="dia-waste" fill="url(#mpHatch)" x="495" y="388" width="65"  height="50"/>

        <text class="dia-small" x="145" y="417" text-anchor="middle">MP 1</text>
        <text class="dia-small" x="245" y="417" text-anchor="middle">MP 2</text>
        <text class="dia-small" x="345" y="417" text-anchor="middle">MP 3</text>
        <text class="dia-small" x="445" y="417" text-anchor="middle">MP 4</text>

        <line class="dia-ext" x1="60"  y1="438" x2="60"  y2="462"/>
        <line class="dia-ext" x1="95"  y1="388" x2="95"  y2="462"/>
        <line class="dia-ext" x1="195" y1="438" x2="195" y2="462"/>
        <line class="dia-ext" x1="495" y1="438" x2="495" y2="462"/>
        <line class="dia-ext" x1="560" y1="438" x2="560" y2="462"/>

        <line class="dia-dim" x1="60"  y1="456" x2="95"  y2="456"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <line class="dia-dim" x1="95"  y1="456" x2="195" y2="456"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>
        <line class="dia-dim" x1="495" y1="456" x2="560" y2="456"
              marker-start="url(#mpDimArrow)" marker-end="url(#mpDimArrow)"/>

        <text class="dia-small" x="77"  y="476" text-anchor="middle">70 mm</text>
        <text class="dia-label" x="145" y="477" text-anchor="middle">MP Width</text>
        <text class="dia-small" x="527" y="476" text-anchor="middle">waste</text>

        <text class="dia-note" x="310" y="502" text-anchor="middle">MP Count is the whole MPs that fit after the 70 mm allowance (4 here). Waste is the strip left over.</text>
      </svg>
    </div>
  </div>

</section>

</div>
</main>
</Layout>

<style>
  /* This tool's own names now resolve to the shared /tools palette in
     styles/tools.css, so its existing rules inherit the unified look
     without being rewritten. Page background, colour and font come from
     .tool-page. Warn stays local — nothing else uses it. */
  .mp-calc{
    --bg:var(--tool-page-bg); --panel:var(--tool-panel);
    --ink:var(--tool-ink); --muted:var(--tool-muted);
    --line:var(--tool-line); --line-strong:var(--tool-line-strong);
    --accent:var(--tool-accent); --accent-ink:var(--tool-accent-ink);
    --accent-soft:var(--tool-accent-soft);
    --out-bg:var(--tool-field-bg);
    --warn:#8a5a00; --warn-bg:#fff6e0;
    --radius:var(--tool-radius);
  }
  .mp-calc *{box-sizing:border-box}

  .mp-calc header p{margin:0 0 18px; color:var(--muted); font-size: var(--tool-fs-base)}
  /* Header layout comes from .tool-header-row in tools.css. */
  .btn-docs{display:inline-flex; align-items:center; white-space:nowrap; flex-shrink:0}
  /* The diagram ships with its own light backdrop, so it keeps a light
     surround in dark mode rather than floating on the dark page. */
  .hero{
    margin:14px 0 20px; padding:10px; background:#eceef1;
    border:1px solid var(--line); border-radius:var(--radius);
    max-width:440px;
  }
  .hero img{display:block; width:100%; height:auto; border-radius:4px}

  /* ---- tabs ----
     sample.css's .nav: a bordered pill tray, the selected item raised onto a
     white chip. The `background:none` and shadow/transform resets are needed
     because .tool-page button in tools.css paints every button as a solid
     accent action. */
  .tabs{
    display:inline-flex; gap:2px; margin-bottom:20px;
    padding:4px; border:1px solid var(--line); border-radius:8px;
    background:var(--surface-2);
  }
  .tab{
    appearance:none; border:none; background:transparent; box-shadow:none;
    color:var(--muted); font:inherit;
    font-size:var(--tool-fs-base); font-weight:var(--tool-fw-medium);
    letter-spacing:0; padding:7px 18px; border-radius:5px; cursor:pointer;
    transition:var(--transition-color), var(--transition-shadow);
  }
  .tab:hover{transform:none; box-shadow:none}
  .tab:hover:not([aria-selected="true"]){
    background:rgba(255,255,255,.5); color:var(--ink);
  }
  .tab[aria-selected="true"]{
    background:var(--panel); color:var(--ink); box-shadow:var(--shadow-sm);
  }
  .tab:focus-visible{outline:3px solid var(--tool-focus); outline-offset:2px}

  /* ---- measurement diagrams ----
     min-width + a scrolling wrapper rather than letting the SVG shrink to fit:
     at phone width a 620-unit viewBox would render the labels at ~6px. */
  .dia-wrap{overflow-x:auto}
  /* Cap at the viewBox width so one user unit is one pixel. Without it the
     620-unit drawing stretched to the full ~1056px card — 1.7x, 886px tall,
     with the 13px labels rendering at 22px. min-width keeps it legible on a
     phone by scrolling inside .dia-wrap rather than shrinking further. */
  .dia{display:block; width:100%; max-width:620px; min-width:520px; height:auto}
  .dia-face-a{fill:var(--accent-soft); stroke:var(--accent); stroke-width:1.25; stroke-linejoin:round}
  .dia-face-b{fill:var(--panel); stroke:var(--accent); stroke-width:1.25; stroke-linejoin:round}
  .dia-edge{fill:none; stroke:var(--accent); stroke-width:2.25; stroke-linejoin:round; stroke-linecap:round}
  .dia-dim{fill:none; stroke:var(--muted); stroke-width:1}
  .dia-ext{fill:none; stroke:var(--line-strong); stroke-width:1; stroke-dasharray:4 3}
  .dia-band{fill:var(--accent-soft); stroke:var(--accent); stroke-width:1.25}
  .dia-allow{fill:var(--line); stroke:var(--line-strong); stroke-width:1.25}
  /* The hatch fill is a presentation attribute on the rect, not a rule here:
     a url(#id) inside an external stylesheet resolves against the stylesheet's
     own URL, so the paint server would silently fail to resolve. */
  .dia-waste{stroke:var(--line-strong); stroke-width:1.25}
  .dia-rule{stroke:var(--line); stroke-width:1}
  .dia-label{fill:var(--ink); font-size: var(--tool-fs-base); font-weight: var(--tool-fw-bold)}
  .dia-small{fill:var(--muted); font-size: var(--tool-fs-sm); font-weight: var(--tool-fw-bold)}
  .dia-note{fill:var(--muted); font-size: var(--tool-fs-sm)}
  .dia-head{fill:var(--muted); font-size: var(--tool-fs-sm); font-weight: var(--tool-fw-bold); letter-spacing:.07em; text-transform:uppercase}

  /* ---- cards ----
     Surface and the panel-heading style come from .tool-page in tools.css. */
  .card > h2 .sub{text-transform:none; letter-spacing:0; font-weight: var(--tool-fw-regular); margin-left:8px}

  /* ---- fields ---- */
  .grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px 18px}
  .f{display:flex; flex-direction:column; gap:5px}
  .f label{font-size: var(--tool-fs-base); color:var(--muted); font-weight: var(--tool-fw-semibold)}
  .f .unit{font-weight: var(--tool-fw-regular); color:var(--line-strong)}
  .mp-calc input[type=number]{width:100%}

  /* Shown only when an input is blank or unusable, so the dashes are explained. */
  .msg{margin:12px 0 0; font-size: var(--tool-fs-base); color:var(--warn)}

  /* ---- outputs ---- */
  .outs{display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:10px}
  .out{
    background:var(--out-bg); border:1px solid var(--line); border-radius:8px; padding:10px 12px;
  }
  .out .k{font-size: var(--tool-fs-base); color:var(--muted); font-weight: var(--tool-fw-semibold); display:block; margin-bottom:2px}
  .out .v{font-size: var(--tool-fs-lg); font-family:var(--font-mono); font-weight: var(--tool-fw-medium); font-variant-numeric:tabular-nums; letter-spacing:-.02em}
  .out .u{font-size: var(--tool-fs-base); font-weight: var(--tool-fw-regular); color:var(--muted); margin-left:3px}
  .out.stale .v{color:var(--muted); opacity:.5}

  .note{
    font-size: var(--tool-fs-base); color:var(--warn); background:var(--warn-bg);
    border:1px solid color-mix(in srgb, var(--warn) 30%, transparent);
    border-radius:7px; padding:8px 11px; margin-top:12px;
  }
  .rule{font-size: var(--tool-fs-base); color:var(--muted); margin-top:12px}
  .rule b{color:var(--ink); font-weight: var(--tool-fw-semibold)}

  /* ---- table ---- */
  .scroll{overflow-x:auto; margin:0 -20px; padding:0 20px}
  .mp-calc table{border-collapse:collapse; width:100%; min-width:560px; font-variant-numeric:tabular-nums}
  .mp-calc th,.mp-calc td{ text-align:right; border-bottom:1px solid var(--line)}
  .mp-calc th:first-child,.mp-calc td:first-child{text-align:left;}
  .mp-calc thead th{ text-transform:uppercase; letter-spacing:.05em;
    color:var(--muted); border-bottom:1px solid var(--line-strong); vertical-align:bottom;
  }
  .mp-calc thead th input[type=number]{width:94px; margin-top:6px; text-align:right;}
  .mp-calc tbody th{}
  .mp-calc td .u{color:var(--muted); margin-left:2px}
  .mp-calc tbody tr:last-child td, .mp-calc tbody tr:last-child th{border-bottom:none}
  .col-self{background:var(--accent-soft)}
  .dash{color:var(--muted); opacity:.45}

  .mp-calc [hidden]{display:none !important}
</style>

<script>
  /* Every id looked up below is rendered by this page, so the lookups are
     asserted non-null rather than guarded one by one. */
  function el<T extends HTMLElement = HTMLElement>(id: string): T {
    return document.getElementById(id) as T;
  }

  /* ---------- Excel-equivalent helpers ---------- */
  const EPS = 1e-9;

  // Excel ROUND(): half away from zero, with a nudge past binary-float artefacts.
  function xround(x: number, d = 0): number {
    if (!isFinite(x)) return NaN;
    const f = Math.pow(10, d);
    let y = x * f;
    y = Math.round(Math.abs(y) + EPS * Math.max(1, Math.abs(y))) * (y < 0 ? -1 : 1);
    return y / f;
  }

  // ROUNDDOWN((w-70)/mp, 0) - IF(MOD(w-70, mp) = 0, 1, 0)
  function mpCount(mmpWidth: number, mpWidth: number): number {
    if (!(mpWidth > 0)) return NaN;
    const q = (mmpWidth - 70) / mpWidth;
    const nearest = Math.round(q);
    const exact = Math.abs(q - nearest) < 1e-9;
    const down = exact ? nearest : Math.floor(q + 1e-9);
    return down - (exact ? 1 : 0);
  }

  // MOD((w-70)/mp, 1)
  function mpRemainder(mmpWidth: number, mpWidth: number): number {
    if (!(mpWidth > 0)) return NaN;
    const q = (mmpWidth - 70) / mpWidth;
    const r = q - Math.floor(q + 1e-9);
    return r < 1e-9 ? 0 : r;
  }

  /* ---------- DOM helpers ---------- */
  function num(id: string): number {
    return parseFloat(el<HTMLInputElement>(id).value);
  }

  function fmt(x: number | null | undefined, d: number): string | null {
    if (x === null || x === undefined || !isFinite(x)) return null;
    return x.toLocaleString(undefined, { minimumFractionDigits: d, maximumFractionDigits: d });
  }

  // Write a value into an .out tile (clears the "stale" dimming).
  function setOut(id: string, text: string | null): void {
    const node = el(id);
    node.textContent = (text === null) ? "---" : text;
    const tile = node.closest(".out");
    if (tile) tile.classList.toggle("stale", text === null);
  }

  // Write a value into a table cell.
  function setCell(id: string, text: string | null): void {
    const node = el(id);
    node.textContent = (text === null) ? "---" : text;
    node.classList.toggle("dash", text === null);
  }

  // Pass null to hide the message entirely.
  function say(id: string, msg: string | null): void {
    const node = el(id);
    node.textContent = msg || "";
    node.hidden = !msg;
  }

  /* ---------- tabs ---------- */
  const tabs = [
    { tab: el("tab-helios"),   panel: el("panel-helios") },
    { tab: el("tab-standard"), panel: el("panel-standard") }
  ];
  tabs.forEach((t, i) => {
    t.tab.addEventListener("click", () => {
      tabs.forEach((o, j) => {
        o.tab.setAttribute("aria-selected", String(i === j));
        o.panel.hidden = (i !== j);
      });
    });
  });

  /* ---------- Helios ---------- */
  const HELIOS_INPUTS = ["h_high", "h_blocks", "h_mpw", "h_mmpw", "h_packw"];
  const HELIOS_OUTS = ["h_low", "h_tblocks", "h_area", "h_slit", "h_count", "h_rem"];

  function heliosClear(): void {
    HELIOS_OUTS.forEach((id) => setOut(id, null));
  }

  function heliosCalc(): void {
    const high   = num("h_high"),
          blocks = num("h_blocks"),
          mpw    = num("h_mpw"),
          mmpw   = num("h_mmpw"),
          packw  = num("h_packw");

    if ([high, blocks, mpw].some((v) => !isFinite(v))) {
      heliosClear();
      say("h_status", "Enter High Pleat, Block Count and MP Width.");
      return;
    }

    // Two spreadsheet variants: < 16 uses -1.3, >= 16 uses -2.0
    const drop = high < 16 ? 1.3 : 2;
    const low  = high - drop;

    const totalBlocks = 2 * blocks + 5;
    const area = xround(0.01 * (5 * 2 * high * mpw + 2 * blocks * (high + low) * mpw), 0);
    const slit = xround((5 * high * 2 + 2 * blocks * (high + low)) / 1000, 3);

    setOut("h_low",     fmt(low, 1));
    setOut("h_tblocks", fmt(totalBlocks, 0));
    setOut("h_area",    fmt(area, 0));
    setOut("h_slit",    fmt(slit, 3));

    el("h_rule").innerHTML = "High Pleat is <b>" + fmt(high, 1) + " mm</b> &rarr; " +
      (high < 16 ? "the <b>&ldquo;less than 16&rdquo;</b> rule applies (Low = High &minus; 1.3)."
                 : "the <b>&ldquo;16 or greater&rdquo;</b> rule applies (Low = High &minus; 2.0).");

    if (isFinite(mmpw) && isFinite(packw) && packw > 0) {
      const c = mpCount(mmpw, packw);
      setOut("h_count", c >= 0 ? fmt(c, 0) : null);
      setOut("h_rem",   fmt(mpRemainder(mmpw, packw), 4));
    } else {
      setOut("h_count", null);
      setOut("h_rem",   null);
    }

    say("h_status", null);
  }

  /* ---------- Standard ---------- */
  const STD_INPUTS = ["s_height", "s_count", "s_mpw", "s_w1", "s_w2", "s_w3"];
  const STD_CELLS = ["s_area0", "s_slit0", "s_area1", "s_slit1", "s_cnt1", "s_wst1", "s_mpa1",
                     "s_area2", "s_slit2", "s_cnt2", "s_wst2", "s_mpa2",
                     "s_area3", "s_slit3", "s_cnt3", "s_wst3", "s_mpa3"];

  function stdClear(): void {
    STD_CELLS.forEach((id) => setCell(id, null));
  }

  function stdCalc(): void {
    const h   = num("s_height"),
          n   = num("s_count"),
          mpw = num("s_mpw");

    if (![h, n, mpw].every(isFinite) || mpw <= 0) {
      stdClear();
      say("s_status", "Enter Pleat Height, Pleat Count and a positive MP Width.");
      return;
    }

    el("s_selfw").textContent = fmt(mpw, 0) + " mm";

    const slit = xround((2 * h * n) / 1000, 3);      // identical for every column
    const areaAt = (w: number) => 0.01 * (2 * h * n * w);

    // "Single MP" column: the MP at its own width, no packing.
    setCell("s_area0", fmt(areaAt(mpw), 2));
    setCell("s_slit0", fmt(slit, 3));

    [1, 2, 3].forEach((i) => {
      const w = num("s_w" + i);
      if (!isFinite(w)) {
        ["s_area", "s_slit", "s_cnt", "s_wst", "s_mpa"].forEach((p) => setCell(p + i, null));
        return;
      }
      const mmpArea = areaAt(w);
      const cnt     = mpCount(w, mpw);
      const waste   = w - 70 - mpw * cnt;

      setCell("s_area" + i, fmt(mmpArea, 2));
      setCell("s_slit" + i, fmt(slit, 3));
      setCell("s_cnt"  + i, cnt >= 1 ? fmt(cnt, 0) : "0");
      setCell("s_wst"  + i, cnt >= 0 ? fmt(waste, 0) : null);
      setCell("s_mpa"  + i, cnt >= 1 ? fmt(xround(mmpArea / cnt, 0), 0) : null);
    });

    say("s_status", null);
  }

  /* ---------- wiring ---------- */
  // Results track the inputs live. "input" covers typing, spinners and paste;
  // "change" catches the commit that some browsers only fire on blur.
  function live(ids: string[], calc: () => void): void {
    ids.forEach((id) => {
      const node = el(id);
      node.addEventListener("input", calc);
      node.addEventListener("change", calc);
    });
  }
  live(HELIOS_INPUTS, heliosCalc);
  live(STD_INPUTS, stdCalc);

  // Land on the spreadsheet's own numbers.
  heliosCalc();
  stdCalc();
</script>
