---
import Layout from '../../layouts/BaseLayout.astro';
const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout>
<style>
  /* ============================================
     LAYOUT
     ============================================ */
  /* The page frame (width, gutters, background, font) comes from .tool-page
     and .tool-shell in tools.css; this is just the two-column split. */
  .uc-layout {
    display: flex;
    flex-direction: row;
    gap: 20px;
  }

  .conversions,
  .calculator {
    flex: 1;
    overflow-y: auto;
  }

  /* ============================================
     TYPOGRAPHY
     ============================================ */
  h3 {
    width: 200px;
    margin: 0 0 12px 0;
  }

  /* ============================================
     MEASUREMENT SELECTOR
     ============================================ */
  .measurement-selector {
    margin-bottom: 16px;
  }

  .measurement-selector label {
    margin-right: 8px;
  }

  .measurement-selector select {
    width: auto;
  }

  /* ============================================
     CONVERTER PANEL (FROM / TO)
     ============================================ */
  .converter-panel {
    display: flex;
    gap: 24px;
  }

  .converter-side {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .converter-side label {
    font-weight: var(--tool-fw-medium);
    font-size: var(--tool-fs-base);
  }

  .converter-side input {
    width: 100%;
  }

  .converter-side select {
    width: 100%;
    box-sizing: border-box;
  }

  .converter-side select option {
    padding: 4px 6px;
  }

  /* ============================================
     SWAP BUTTON
     ============================================ */
  .swap-btn-container {
    display: flex;
    align-items: center;
    padding-top: 30px; /* offset for From/To labels */
  }

  .swap-btn {
    background: none;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 6px 10px;
    font-size: var(--tool-fs-lg);
    cursor: pointer;
    color: var(--text-secondary);
    transition: border-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .swap-btn:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
  }

  @media (max-width: 900px) {
    .swap-btn-container {
      padding-top: 0;
      justify-content: center;
    }
  }

  /* ============================================
     REYNOLDS FLOW STATUS BADGE
     ============================================ */
  .re-flow-status {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 4px;
    font-weight: var(--tool-fw-semibold);
    font-size: var(--tool-fs-base);
    min-width: 100px;
    text-align: center;
    border: 1px solid transparent;
  }

  .re-flow-status.laminar {
    background: #d4edda;
    color: #155724;
    border-color: #c3e6cb;
  }

  .re-flow-status.transitional {
    background: #fff3cd;
    color: #856404;
    border-color: #ffeeba;
  }

  .re-flow-status.turbulent {
    background: #f8d7da;
    color: #721c24;
    border-color: #f5c6cb;
  }

  /* ============================================
     CONVERSION ROWS (for calculators)
     ============================================ */
  .unit-row {
    display: flex;
    gap: 16px;
    margin-bottom: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  .row-inline {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .row-inline label {
    width: 130px;
    text-align: left;
    flex-shrink: 0;
    font-weight: var(--tool-fw-medium);
  }

  /* ============================================
     FORM ELEMENTS
     ============================================ */
  /* The value field gives up the room. It is the flexible one, so widening the
     unit select below takes the space from here automatically. */
  .value {
    flex: 1;
    min-width: 80px;
  }

  /* 80px left a 50px content box once the shared 10px/14px padding and border
     were taken off, and the native dropdown arrow claimed ~20px of that — so
     the widest labels (lb/ft^3, gal(US), mm^2/s) were clipped. flex-shrink:0
     stops the row squeezing it back. */
  .unit {
    width: 116px;
    flex-shrink: 0;
  }

  /* ============================================
     READOUTS AND HINTS
     ============================================ */
  .readout {
    font-weight: var(--tool-fw-semibold);
  }

  .tool-card .hint {
    margin: 8px 0 0;
  }

  /* ============================================
     ISO 4406 TABLE
     ============================================ */
  .iso-table {
    margin-top: 8px;
  }

  .iso-table th,
  .iso-table td {
    text-align: left;
    white-space: nowrap;
  }

  .iso-table input {
    width: 100%;
    min-width: 90px;
    box-sizing: border-box;
  }

  .iso-range {
    color: var(--tool-muted);
  }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media (max-width: 900px) {
    .uc-layout {
      flex-direction: column;
    }

    .converter-panel {
      flex-direction: column;
    }
  }
</style>

<main class="tool-page">
<div class="tool-shell">

  <header class="tool-header">
    <div class="tool-header-row">
      <h1>Unit Conversion</h1>
    </div>
    <p class="tool-subtitle">
      Convert between engineering units, size pipes and tanks, and translate filter beta ratios and ISO 4406 cleanliness codes.
    </p>
  </header>

<div class="uc-layout">
 <!-- Left: Unit Conversions -->
  <div class="conversions">
    <h2>Engineering Unit Converter</h2>

    <div class="tool-card">
      <!-- Measurement type selector -->
      <div class="measurement-selector">
        <label for="measurementType">Measurement:</label>
        <select id="measurementType"></select>
      </div>

      <!-- From / To converter panel -->
      <div class="converter-panel">
        <div class="converter-side">
          <label for="fromValue">From:</label>
          <input id="fromValue" type="number" value="1" step="any" />
          <select id="fromUnit" size="10"></select>
        </div>

        <div class="swap-btn-container">
          <button class="swap-btn" id="swapBtn" title="Swap units and values">⇄</button>
        </div>

        <div class="converter-side">
          <label for="toValue">To:</label>
          <input id="toValue" type="number" value="" step="any" />
          <select id="toUnit" size="10"></select>
        </div>
      </div>
    </div>

    <h2>Filtration</h2>

    <!-- Beta Ratio -->
    <div class="tool-card">
      <h3>Beta Ratio</h3>
      <div class="row-inline">
        <label for="betaRatio">Beta Ratio (β):</label>
        <input id="betaRatio" class="value" type="number" value="200" step="any" min="1"/>
      </div>
      <div class="row-inline">
        <label for="betaEfficiency">Efficiency (%):</label>
        <input id="betaEfficiency" class="value" type="number" step="any" min="0" max="100"/>
      </div>
      <p class="hint">β = upstream ÷ downstream particle count at one size. Efficiency = (1 − 1/β) × 100.</p>
    </div>

    <!-- ISO 4406 Code -->
    <div class="tool-card">
      <h3>ISO 4406 Code</h3>
      <div class="row-inline">
        <label for="isoCode">ISO Code:</label>
        <input id="isoCode" class="value" type="text" value="18/16/13" placeholder="e.g. 18/16/13" spellcheck="false" autocomplete="off"/>
      </div>
      <div class="table-wrap">
        <table class="iso-table">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col">Particles / mL</th>
              <th scope="col">Scale No.</th>
              <th scope="col">Range / mL</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">≥4 µm(c)</th>
              <td><input id="iso4Count" type="number" step="any" min="0" aria-label="Particles ≥4 µm(c) per mL"/></td>
              <td id="iso4Scale"></td>
              <td id="iso4Range" class="iso-range"></td>
            </tr>
            <tr>
              <th scope="row">≥6 µm(c)</th>
              <td><input id="iso6Count" type="number" step="any" min="0" aria-label="Particles ≥6 µm(c) per mL"/></td>
              <td id="iso6Scale"></td>
              <td id="iso6Range" class="iso-range"></td>
            </tr>
            <tr>
              <th scope="row">≥14 µm(c)</th>
              <td><input id="iso14Count" type="number" step="any" min="0" aria-label="Particles ≥14 µm(c) per mL"/></td>
              <td id="iso14Scale"></td>
              <td id="iso14Range" class="iso-range"></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="hint">Entering a code fills each count with the top of its range. Use - for a size that was not counted.</p>
    </div>
  </div>

  <!-- Right: Calculators -->
  <div class="calculator">
    <h2>Calculators</h2>

    <!-- Pipe Velocity -->
    <div class="tool-card">
      <h3>Pipe Velocity</h3>
      <div class="row-inline">
        <label>Diameter:</label>
        <input id="pipeDiameter" class="value" type="number" value="1.0" step="any" min="0"/>
        <select id="pipeDiameterUnit" class="unit"></select>
      </div>
      <div class="row-inline">
        <label>Flow Rate:</label>
        <input id="pipeFlow" class="value" type="number" value="1.0" step="any" min="0"/>
        <select id="pipeFlowUnit" class="unit"></select>
      </div>
      <div class="row-inline">
        <label>Velocity:</label>
        <input id="pipeVelocity" class="value" type="number" value="0" step="any" min="0"/>
        <select id="pipeVelocityUnit" class="unit"></select>
      </div>
    </div>

    <!-- Dash Size -->
    <div class="tool-card">
      <h3>Dash Size</h3>
      <div class="row-inline">
        <label for="dashNumber">Dash Size (-#):</label>
        <input id="dashNumber" class="value" type="number" value="8" step="any" min="0"/>
      </div>
      <div class="row-inline">
        <label for="dashSize">Size:</label>
        <input id="dashSize" class="value" type="number" step="any" min="0"/>
        <select id="dashSizeUnit" class="unit"></select>
      </div>
      <div class="row-inline">
        <label>Fraction:</label>
        <span id="dashFraction" class="readout"></span>
      </div>
      <p class="hint">The dash number is the size in sixteenths of an inch: hose ID or tube OD.</p>
    </div>

    <!-- Circle Area -->
    <div class="tool-card">
      <h3>Circle Area</h3>
      <div class="row-inline">
        <label for="circleDiameter">Diameter:</label>
        <input id="circleDiameter" class="value" type="number" value="1" step="any" min="0"/>
        <select id="circleDiameterUnit" class="unit"></select>
      </div>
      <div class="row-inline">
        <label for="circleRadius">Radius:</label>
        <input id="circleRadius" class="value" type="number" step="any" min="0"/>
        <select id="circleRadiusUnit" class="unit"></select>
      </div>
      <div class="row-inline">
        <label for="circleCircumference">Circumference:</label>
        <input id="circleCircumference" class="value" type="number" step="any" min="0"/>
        <select id="circleCircumferenceUnit" class="unit"></select>
      </div>
      <div class="row-inline">
        <label for="circleArea">Area:</label>
        <input id="circleArea" class="value" type="number" step="any" min="0"/>
        <select id="circleAreaUnit" class="unit"></select>
      </div>
    </div>
<!-- Reynolds Number -->
<div class="tool-card">
  <h3>Reynolds Number</h3>

  <div class="row-inline">
    <label>Density (ρ):</label>
    <input id="reDensity" class="value" type="number" value="1000" step="any" min="0"/>
    <select id="reDensityUnit" class="unit"></select>
  </div>

  <div class="row-inline">
    <label>Velocity (V):</label>
    <input id="reVelocity" class="value" type="number" value="1" step="any" min="0"/>
    <select id="reVelocityUnit" class="unit"></select>
  </div>

  <div class="row-inline">
    <label>Diameter (D):</label>
    <input id="reDiameter" class="value" type="number" value="0.05" step="any" min="0"/>
    <select id="reDiameterUnit" class="unit"></select>
  </div>

  <div class="row-inline">
    <label>Dyn. Viscosity (μ):</label>
    <input id="reDynVisc" class="value" type="number" value="0.001" step="any" min="0"/>
    <select id="reDynViscUnit" class="unit"></select>
  </div>

  <div class="row-inline">
    <label>Reynolds No.:</label>
    <!-- text, not number: a zero viscosity shows "∞", which a number input rejects -->
    <input id="reValue" class="value" type="text" value="0" readonly/>
  </div>

  <div class="row-inline">
    <label>Flow Regime:</label>
    <span id="reFlowStatus" class="re-flow-status"></span>
  </div>
</div>

    <!-- Turnover Ratio -->
    <div class="tool-card">
      <h3>Turnover Ratio</h3>
      <div class="row-inline">
        <label for="tankFlow">Flow Rate:</label>
        <input id="tankFlow" class="value" type="number" value="10" step="any" min="0"/>
        <select id="tankFlowUnit" class="unit"></select>
      </div>
      <div class="row-inline">
        <label for="tankVolume">Tank Volume:</label>
        <input id="tankVolume" class="value" type="number" value="30" step="any" min="0"/>
        <select id="tankVolumeUnit" class="unit"></select>
      </div>
      <div class="row-inline">
        <label for="tankTurnover">Turnover:</label>
        <input id="tankTurnover" class="value" type="number" step="any" min="0"/>
        <select id="tankTurnoverUnit" class="unit"></select>
      </div>
      <div class="row-inline">
        <label for="tankDwell">Dwell Time (min):</label>
        <input id="tankDwell" class="value" type="number" readonly/>
      </div>
      <p class="hint">Turnover = flow rate ÷ tank volume. Editing it solves for the tank volume. Dwell time is the inverse.</p>
    </div>

    <!-- Percent Change -->
    <div class="tool-card">
      <h3>Percent Change</h3>
      <div class="row-inline">
        <label>Original Value:</label>
        <input id="pctOriginal" class="value" type="number" step="any" placeholder="e.g. 50"/>
      </div>
      <div class="row-inline">
        <label>New Value:</label>
        <input id="pctNew" class="value" type="number" step="any" placeholder="e.g. 75"/>
      </div>
      <div class="row-inline">
        <label>% Change:</label>
        <input id="pctResult" class="value" type="text" placeholder="e.g. +50%"/>
      </div>
      <p class="hint">Type a % change here to solve for the new value.</p>
    </div>

  </div>
</div>

</div>
</main>

<!-- is:inline: Astro 7 drops a <script> whose src is an expression unless it
     is marked inline; these are plain scripts from public/, output as written. -->
<script is:inline src={`${BASE_PATH}/scripts/unit_converter.js`}></script>
<script is:inline src={`${BASE_PATH}/scripts/calculators.js`}></script>

<script>
// ========== DOM REFS ==========
const measurementSelect = document.getElementById('measurementType');
const fromValue = document.getElementById('fromValue');
const toValue   = document.getElementById('toValue');
const fromUnit  = document.getElementById('fromUnit');
const toUnit    = document.getElementById('toUnit');

// ========== POPULATE MEASUREMENT DROPDOWN ==========
const measurements = getAvailableMeasurements();

measurements.forEach(m => {
  const opt = new Option(m.displayName, m.key);
  measurementSelect.add(opt);
});

/**
 * Populate From and To unit listboxes based on the selected measurement.
 * Resets to defaults for the selected measurement category.
 */
function populateUnitLists() {
  const key = measurementSelect.value;
  const meas = measurements.find(m => m.key === key);
  const units = getAvailableUnits(meas.unitType);

  fromUnit.innerHTML = '';
  toUnit.innerHTML   = '';

  units.forEach(u => {
    const label = getUnitDisplayName(u);
    fromUnit.add(new Option(label, u));
    toUnit.add(new Option(label, u));
  });

  fromUnit.value = getFromDefault(key) || units[0];
  toUnit.value   = getToDefault(key)   || (units.length > 1 ? units[1] : units[0]);
}

// ========== CONVERSION LOGIC ==========
let isUpdating = false;

function convertFromTo() {
  if (isUpdating) return;
  isUpdating = true;

  const value = parseFloat(fromValue.value);
  if (Number.isFinite(value)) {
    try {
      const result = convertUnit(fromUnit.value, toUnit.value, value);
      toValue.value = formatSigFigs(result);
    } catch (e) {
      toValue.value = 'Error';
    }
  } else {
    toValue.value = '';
  }

  isUpdating = false;
}

function convertToFrom() {
  if (isUpdating) return;
  isUpdating = true;

  const value = parseFloat(toValue.value);
  if (Number.isFinite(value)) {
    try {
      const result = convertUnit(toUnit.value, fromUnit.value, value);
      fromValue.value = formatSigFigs(result);
    } catch (e) {
      fromValue.value = 'Error';
    }
  } else {
    fromValue.value = '';
  }

  isUpdating = false;
}

// ========== EVENT LISTENERS ==========
measurementSelect.addEventListener('change', () => {
  populateUnitLists();
  fromValue.value = 1;
  convertFromTo();
});

fromValue.addEventListener('input', convertFromTo);
toValue.addEventListener('input', convertToFrom);
fromUnit.addEventListener('change', convertFromTo);
toUnit.addEventListener('change', convertFromTo);

document.getElementById('swapBtn').addEventListener('click', () => {
  const tmpUnit = fromUnit.value;
  const tmpVal  = fromValue.value;
  fromUnit.value  = toUnit.value;
  fromValue.value = toValue.value;
  toUnit.value  = tmpUnit;
  toValue.value = tmpVal;
  convertFromTo();
});

// ========== INIT ==========
populateUnitLists();
convertFromTo();

</script>
</Layout>
