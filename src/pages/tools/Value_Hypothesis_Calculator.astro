        <p class="tool-subtitle">
          Forecast aftermarket revenue and margin across a machine fleet's lifetime,
          and the tank, oil and CO₂ savings from a smaller Air-X tank.
        </p>
      </header>

      <section class="tool-card toolbar" aria-label="Calculation Parameters">




        <div class="control-grid">
          <label class="field">
            <span>Machines per Year</span>
            <input id="machinesPerYear" type="number" min="0" step="50" value="1000">
          </label>

          <label class="field">
            <span>Filter Replacements per Machine/Year</span>
            <input id="replacementsPerYear" type="number" min="0" step="0.1" value="2">
          </label>

          <label class="field">
            <span>Selling Price per Filter</span>
            <div class="input-unit">
              <input id="partPrice" type="number" min="0" step="5" value="100">
              <span>USD</span>
            </div>
          </label>

          <label class="field">
            <span>Filter Profit Margin</span>
            <div class="input-unit">
              <input id="marginPercent" type="number" min="0" max="100" step="1" value="50">
              <span>%</span>
            </div>
          </label>
        </div>

        <div class="control-grid">
          <label class="field">
            <span>Forecast Period</span>
            <div class="input-unit">
              <input id="forecastYears" type="number" min="1" max="30" step="1" value="15">
              <span>Years</span>
            </div>
          </label>

          <label class="field">
            <span>Machine Lifetime</span>
            <div class="input-unit">
              <input id="machineLife" type="number" min="1" max="30" step="1" value="18">
              <span>Years</span>
            </div>
          </label>

          <label class="field">
            <span>Aftermarket Share Without Protection</span>
            <div class="input-unit">
              <input id="baseShare" type="number" min="0" max="100" step="1" value="35">
              <span>%</span>
            </div>
          </label>

          <label class="field">
            <span>Aftermarket Share With Protection</span>
            <div class="input-unit">
              <input id="protectedShare" type="number" min="0" max="100" step="1" value="95">
              <span>%</span>
            </div>
          </label>
        </div>
      </section>

      <section class="tool-card toolbar tank-section" aria-label="Tank Reduction">
        <div class="savings-strip">
          <!-- Row 1: Tank Reduction headline -->
          <div class="savings-headline">
            <div class="savings-copy">
              <div class="savings-title-row">
                <p class="eyebrow">Tank Reduction &middot; Smaller Hydraulic Tank Enabled by Element Deaeration Technology</p>
              </div>
            </div>
          </div>

          <!-- Row 2: Baseline vs Air-X comparison -->
          <div class="tank-compare-wrap">
            <table class="tank-compare">
              <thead>
                <tr>
                  <th scope="col">Per Tank</th>
                  <th scope="col">Baseline Tank</th>
                  <th scope="col" class="airx-col">Air-X Tank</th>
                </tr>
              </thead>
              <tbody>
                <tr class="optional-row" data-optional="Steel">
                  <th scope="row">
                    <span class="row-head">
                      <span>Tank Steel Volume</span>
                    <label class="toggle">
                      <input type="checkbox" id="toggleSteel" data-toggles="Steel" checked>
                      <span class="toggle-track"></span>
                      <span class="toggle-thumb"></span>
                      <span class="visually-hidden">Include tank steel volume</span>
                    </label>
                    </span>
                  </th>
                  <td>
                    <div class="input-unit">
                      <input id="baseSteelVolume" type="number" min="0" step="5" value="415">
                      <span>in³</span>
                    </div>
                  </td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <div class="input-unit">
                        <input id="airxSteelVolume" type="number" min="0" step="5" value="294">
                        <span>in³</span>
                      </div>
                      <span class="cell-delta" id="airxSteelVolumeDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="optional-row is-derived" data-optional="Steel">
                  <th scope="row">Tank Steel Cost</th>
                  <td id="baseSteelCost">0 USD</td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <span id="airxSteelCost">0 USD</span>
                      <span class="cell-delta" id="airxSteelCostDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="optional-row" data-optional="Oil">
                  <th scope="row">
                    <span class="row-head">
                      <span>Oil Volume</span>
                    <label class="toggle">
                      <input type="checkbox" id="toggleOil" data-toggles="Oil" checked>
                      <span class="toggle-track"></span>
                      <span class="toggle-thumb"></span>
                      <span class="visually-hidden">Include oil volume</span>
                    </label>
                    </span>
                  </th>
                  <td>
                    <div class="input-unit">
                      <input id="baseOilVolume" type="number" min="0" step="1" value="40">
                      <span>gal</span>
                    </div>
                  </td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <div class="input-unit">
                        <input id="airxOilVolume" type="number" min="0" step="1" value="26">
                        <span>gal</span>
                      </div>
                      <span class="cell-delta" id="airxOilVolumeDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="optional-row is-derived" data-optional="Oil">
                  <th scope="row">Oil Cost per change</th>
                  <td id="baseOilCost">0 USD</td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <span id="airxOilCost">0 USD</span>
                      <span class="cell-delta" id="airxOilCostDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="optional-row" data-optional="Complexity">
                  <th scope="row">
                    <span class="row-head">
                      <span>Tank Complexity</span>
                    <label class="toggle">
                      <input type="checkbox" id="toggleComplexity" data-toggles="Complexity">
                      <span class="toggle-track"></span>
                      <span class="toggle-thumb"></span>
                      <span class="visually-hidden">Include tank complexity</span>
                    </label>
                    </span>
                  </th>
                  <td>
                    <div class="input-unit">
                      <input id="baseComplexityCost" type="number" min="0" step="10" value="0">
                      <span>USD</span>
                    </div>
                  </td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <div class="input-unit">
                        <input id="airxComplexityCost" type="number" min="0" step="10" value="0">
                        <span>USD</span>
                      </div>
                      <span class="cell-delta" id="airxComplexityCostDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="optional-row" data-optional="Flushing">
                  <th scope="row">
                    <span class="row-head">
                      <span>Flushing Cost</span>
                    <label class="toggle">
                      <input type="checkbox" id="toggleFlushing" data-toggles="Flushing">
                      <span class="toggle-track"></span>
                      <span class="toggle-thumb"></span>
                      <span class="visually-hidden">Include flushing cost</span>
                    </label>
                    </span>
                  </th>
                  <td>
                    <div class="input-unit">
                      <input id="baseFlushingCost" type="number" min="0" step="10" value="0">
                      <span>USD</span>
                    </div>
                  </td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <div class="input-unit">
                        <input id="airxFlushingCost" type="number" min="0" step="10" value="0">
                        <span>USD</span>
                      </div>
                      <span class="cell-delta" id="airxFlushingCostDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="optional-row" data-optional="Filter">
                  <th scope="row">
                    <span class="row-head">
                      <span>Filter Cost</span>
                    <label class="toggle">
                      <input type="checkbox" id="toggleFilter" data-toggles="Filter">
                      <span class="toggle-track"></span>
                      <span class="toggle-thumb"></span>
                      <span class="visually-hidden">Include filter cost</span>
                    </label>
                    </span>
                  </th>
                  <td>
                    <div class="input-unit">
                      <input id="baseFilterCost" type="number" min="0" step="5" value="0">
                      <span>USD</span>
                    </div>
                  </td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <span id="airxFilterCost">0 USD</span>
                      <span class="cell-delta" id="airxFilterCostDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="compare-co2">
                  <th scope="row">CO₂ Reduction from Oil</th>
                  <td class="reference-cell">Reference</td>
                  <td class="airx-col co2-value">
                    <div class="airx-cell">
                      <span id="co2Reduction">0 lbs CO₂</span>
                      <span class="cell-delta" id="co2ReductionDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="compare-total">
                  <th scope="row">Total System Cost Per Machine</th>
                  <td id="baseTotalCost">0 USD</td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <span id="airxTotalCost">0 USD</span>
                      <span class="cell-delta" id="airxTotalCostDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="compare-total">
                  <th scope="row">Total Weight (Steel + Oil) Per Machine</th>
                  <td id="baseTotalWeight">0 lbs</td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <span id="airxTotalWeight">0 lbs</span>
                      <span class="cell-delta" id="airxTotalWeightDelta"></span>
                    </div>
                  </td>
                </tr>
                <tr class="compare-total">
                  <th scope="row">Annual Tank Cost for Machines</th>
                  <td id="baseFleetSystemCost">0 USD</td>
                  <td class="airx-col">
                    <div class="airx-cell">
                      <span id="airxFleetSystemCost">0 USD</span>
                      <span class="cell-delta" id="airxFleetSystemCostDelta"></span>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Row 3: Rates used by the comparison -->
          <div class="tank-rate-row">
            <label class="field">
              <span>Steel Cost</span>
              <div class="input-unit">
                <input id="steelCostPerVolume" type="number" min="0" step="0.01" value="0.35">
                <span>USD/in³</span>
              </div>
            </label>

            <label class="field">
              <span>Oil Cost per Gallon</span>
              <div class="input-unit">
                <input id="oilCostPerGallon" type="number" min="0" step="0.1" value="20">
                <span>USD/gal</span>
              </div>
            </label>

            <label class="field">
              <span>Oil Changes per Machine/Year</span>
              <div class="input-unit">
                <input id="oilChangesPerMachineYear" type="number" min="0" step="0.25" value="2">
                <span>per year</span>
              </div>
            </label>
          </div>

          <p class="tank-compare-note">
            Weights assume 0.2836 lbs/in³ steel (490 lbs/ft³) and 7.5 lbs/gal hydraulic oil. CO₂ reduction uses 23.62 lbs CO₂ per gallon of oil saved.
          </p>
        </div> <!-- closes .savings-strip -->
      </section>

      <section class="content-grid">
        <section class="tool-card impact-panel" aria-label="Cumulative Revenue">
          <div class="impact-copy">
            <h2>Aftermarket Protection Impact</h2>

            <div class="metric-row panel-metrics">
              <article class="metric">
                <span>Cumulative Revenue</span>
                <strong id="totalRevenue">0 USD</strong>
                <em class="metric-delta" id="deltaRevenue">(0 USD from Protection)</em>
              </article>
              <article class="metric">
                <span>Cumulative Profit Margin</span>
                <strong id="totalMargin">0 USD</strong>
                <em class="metric-delta" id="deltaMargin">(0 USD from Protection)</em>
              </article>
            </div>

          </div>

          <div class="impact-bars" id="impactBars">
            <div class="bar-row">
              <div class="bar-label">
                <span>Without Aftermarket Protection</span>
                <strong id="impactBaseRevenue">0 USD</strong>
              </div>
              <div class="bar-track">
                <i id="impactBaseBar"></i>
              </div>
            </div>

            <div class="bar-row protected">
              <div class="bar-label">
                <span>With Aftermarket  Protection</span>
                <strong id="impactProtectedRevenue">0 USD</strong>
              </div>
              <div class="bar-track">
                <i id="impactProtectedBaseBar"></i>
                <b id="impactDeltaBar"></b>
              </div>
              <div class="bar-split-legend">
                <span class="key-base">Base Revenue <strong id="impactBaseShareValue">0 USD</strong></span>
                <span class="key-delta">Additional from Protection <strong id="impactDeltaValue">0 USD</strong></span>
              </div>
            </div>
          </div>
        </section>

        <section class="tool-card impact-panel savings-panel" aria-label="Tank Reduction Savings">
          <div class="impact-copy">
            <h2>Tank Reduction Impact</h2>

            <div class="metric-row panel-metrics">
              <article class="metric savings">
                <span>Cumulative Tank Reduction Savings</span>
                <strong id="totalInitialSavings">0 USD</strong>
                <em class="metric-delta">(vs $0 reduction of baseline)</em>
              </article>
              <article class="metric savings">
                <span>Cumulative CO₂ Reduction</span>
                <strong id="totalCo2Reduction">0 lbs CO₂</strong>
                <em class="metric-delta">(vs 0 lbs CO₂ reduction of baseline)</em>
              </article>
            </div>

          </div>

          <div class="impact-bars" id="tankBars">
            <div class="bar-row">
              <div class="bar-label">
                <span>Without Tank Reduction</span>
                <strong id="tankBaseSavings">$0</strong>
              </div>
              <div class="bar-track">
                <i id="tankBaseBar"></i>
              </div>
            </div>

            <div class="bar-row protected savings-bar">
              <div class="bar-label">
                <span>With Air-X Tank Reduction</span>
                <strong id="tankTotalSavings">0 USD</strong>
              </div>
              <div class="bar-track">
                <i id="tankSavingsBar"></i>
                <b id="oilSavingsBar"></b>
              </div>
              <div class="bar-split-legend">
                <span class="key-tank">Tank <strong id="tankSavingsValue">0 USD</strong></span>
                <span class="key-oil">Oil <strong id="oilSavingsValue">0 USD</strong></span>
              </div>
            </div>
          </div>
        </section>

        <section class="tool-card chart-panel" aria-label="Aftermarket Development">
          <div class="panel-head">
            <div>
              <h2>Revenue and Cost Savings</h2>
            </div>
            <div class="legend" id="legend"></div>
          </div>
          <div class="chart-canvas-wrap">
            <canvas id="aftermarketChart" height="140"></canvas>
            <div class="chart-tooltip" id="chartTooltip" hidden></div>
          </div>
        </section>

        <section class="tool-card table-panel" aria-label="Annual Data">
          <div class="panel-head">
            <div>
              <h2>Revenue Overview</h2>
            </div>
            <div class="panel-actions">
              <button
                class="btn-quiet table-toggle"
                type="button"
                aria-controls="revenueTable"
                aria-expanded="false"
                data-show="Show table"
                data-hide="Hide table"
              >Show table</button>
              <!-- Hidden, not removed: downloadCsv() and its listener are left
                   intact below, so dropping this `hidden` brings it back. -->
              <button id="downloadCsv" type="button" hidden>Export CSV</button>
            </div>
          </div>

          <div class="table-wrap" id="revenueTable" hidden>
            <table>
              <thead>
                <tr>
                  <th>Year</th>
                  <th>Total Active Machines</th>
                  <th>Annual Element Demand</th>
                  <th class="hl-without">Revenue Without Protection</th>
                  <th>Margin <span class="hl-without">Without</span> Protection</th>
                  <th class="hl-with">Revenue With Protection</th>
                  <th>Additional Revenue <span class="hl-with">With</span> Protection</th>
                  <th>Margin <span class="hl-with">With</span> Protection</th>
                  <th>Additional Margin <span class="hl-with">With</span> Protection</th>
                  <th>Cumulative Revenue</th>
                  <th>Cumulative Margin</th>
                </tr>
              </thead>
              <tbody id="dataRows"></tbody>
            </table>
          </div>
        </section>

        <section class="tool-card table-panel" aria-label="Tank and Oil Savings">
          <div class="panel-head">
            <div>
              <h2>Tank and Oil Savings</h2>
            </div>
            <div class="panel-actions">
              <button
                class="btn-quiet table-toggle"
                type="button"
                aria-controls="savingsTable"
                aria-expanded="false"
                data-show="Show table"
                data-hide="Hide table"
              >Show table</button>
            </div>
          </div>

          <div class="table-wrap" id="savingsTable" hidden>
            <table class="savings-table">
              <thead>
                <tr>
                  <th>Year</th>
                  <th>Total Active Machines</th>
                  <th>Tank Build Savings (New Machines)</th>
                  <th>Oil Fills</th>
                  <th>Annual Oil Savings</th>
                  <th>Annual Savings Total</th>
                  <th>Cumulative Savings</th>
                </tr>
              </thead>
              <tbody id="savingsRows"></tbody>
            </table>
          </div>
        </section>
      </section>
