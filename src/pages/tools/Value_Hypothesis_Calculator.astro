  <!-- is:inline keeps this ~800-line calculator as plain JS. Astro would
       otherwise compile it as TypeScript, which the untyped DOM lookups here
       would not survive. -->
  <script is:inline>
      const elements = {
  machinesPerYear: document.querySelector("#machinesPerYear"),
  replacementsPerYear: document.querySelector("#replacementsPerYear"),
  partPrice: document.querySelector("#partPrice"),
  marginPercent: document.querySelector("#marginPercent"),
  baseSteelVolume: document.querySelector("#baseSteelVolume"),
  airxSteelVolume: document.querySelector("#airxSteelVolume"),
  baseOilVolume: document.querySelector("#baseOilVolume"),
  airxOilVolume: document.querySelector("#airxOilVolume"),
  steelCostPerVolume: document.querySelector("#steelCostPerVolume"),
  oilCostPerGallon: document.querySelector("#oilCostPerGallon"),
  oilChangesPerMachineYear: document.querySelector("#oilChangesPerMachineYear"),
  baseSteelCost: document.querySelector("#baseSteelCost"),
  airxSteelCost: document.querySelector("#airxSteelCost"),
  baseOilCost: document.querySelector("#baseOilCost"),
  airxOilCost: document.querySelector("#airxOilCost"),
  baseTotalCost: document.querySelector("#baseTotalCost"),
  airxTotalCost: document.querySelector("#airxTotalCost"),
  baseTotalWeight: document.querySelector("#baseTotalWeight"),
  airxTotalWeight: document.querySelector("#airxTotalWeight"),
  baseFleetSystemCost: document.querySelector("#baseFleetSystemCost"),
  airxFleetSystemCost: document.querySelector("#airxFleetSystemCost"),
  airxFleetSystemCostDelta: document.querySelector("#airxFleetSystemCostDelta"),
  airxSteelVolumeDelta: document.querySelector("#airxSteelVolumeDelta"),
  airxSteelCostDelta: document.querySelector("#airxSteelCostDelta"),
  airxOilVolumeDelta: document.querySelector("#airxOilVolumeDelta"),
  airxOilCostDelta: document.querySelector("#airxOilCostDelta"),
  airxTotalCostDelta: document.querySelector("#airxTotalCostDelta"),
  airxTotalWeightDelta: document.querySelector("#airxTotalWeightDelta"),
  co2ReductionDelta: document.querySelector("#co2ReductionDelta"),
  forecastYears: document.querySelector("#forecastYears"),
  machineLife: document.querySelector("#machineLife"),
  baseShare: document.querySelector("#baseShare"),
  totalRevenue: document.querySelector("#totalRevenue"),
  totalMargin: document.querySelector("#totalMargin"),
  totalInitialSavings: document.querySelector("#totalInitialSavings"),
  deltaRevenue: document.querySelector("#deltaRevenue"),
  deltaMargin: document.querySelector("#deltaMargin"),
  impactBaseRevenue: document.querySelector("#impactBaseRevenue"),
  impactProtectedRevenue: document.querySelector("#impactProtectedRevenue"),
  impactBaseBar: document.querySelector("#impactBaseBar"),
  impactProtectedBaseBar: document.querySelector("#impactProtectedBaseBar"),
  impactDeltaBar: document.querySelector("#impactDeltaBar"),
  impactBaseShareValue: document.querySelector("#impactBaseShareValue"),
  impactDeltaValue: document.querySelector("#impactDeltaValue"),
  tankBaseSavings: document.querySelector("#tankBaseSavings"),
  tankTotalSavings: document.querySelector("#tankTotalSavings"),
  tankBaseBar: document.querySelector("#tankBaseBar"),
  oilSavingsBar: document.querySelector("#oilSavingsBar"),
  tankSavingsBar: document.querySelector("#tankSavingsBar"),
  tankSavingsValue: document.querySelector("#tankSavingsValue"),
  oilSavingsValue: document.querySelector("#oilSavingsValue"),
  chart: document.querySelector("#aftermarketChart"),
  chartTooltip: document.querySelector("#chartTooltip"),
  legend: document.querySelector("#legend"),
  dataRows: document.querySelector("#dataRows"),
  savingsRows: document.querySelector("#savingsRows"),
  downloadCsv: document.querySelector("#downloadCsv"),
  protectedShare: document.querySelector("#protectedShare"),
co2Reduction: document.querySelector("#co2Reduction"),
baseComplexityCost: document.querySelector("#baseComplexityCost"),
airxComplexityCost: document.querySelector("#airxComplexityCost"),
airxComplexityCostDelta: document.querySelector("#airxComplexityCostDelta"),
baseFlushingCost: document.querySelector("#baseFlushingCost"),
airxFlushingCost: document.querySelector("#airxFlushingCost"),
airxFlushingCostDelta: document.querySelector("#airxFlushingCostDelta"),
baseFilterCost: document.querySelector("#baseFilterCost"),
airxFilterCost: document.querySelector("#airxFilterCost"),
airxFilterCostDelta: document.querySelector("#airxFilterCostDelta"),
toggleSteel: document.querySelector("#toggleSteel"),
toggleOil: document.querySelector("#toggleOil"),
toggleComplexity: document.querySelector("#toggleComplexity"),
toggleFlushing: document.querySelector("#toggleFlushing"),
toggleFilter: document.querySelector("#toggleFilter"),
totalCo2Reduction: document.querySelector("#totalCo2Reduction"),
};


const chartColors = {
  baseRevenue: "#2f6fbd",
  baseMargin: "#7c8b91",
  protectedRevenue: "#d55246",
  protectedMargin: "#00796b",
  initialSavings: "#159464"
};

// Round caps on a 1px dash render as dots.
const DOTTED_LINE = [1, 6];
const DASHED_LINE = [2, 5];

// Geometry of the last chart render, so hover can map a mouse x back to a year.
let chartGeometry = null;
let chartHoverIndex = null;

let latestRows = [];

// Physical assumptions used by the Baseline vs. Air-X comparison.
const STEEL_DENSITY_LBS_PER_IN3 = 0.2836; // 490 lbs/ft³
const OIL_DENSITY_LBS_PER_GAL = 7.5;
const CO2_LBS_PER_GAL_OIL = 23.62;

function numberValue(input, fallback = 0) {
  // Number("") is 0, so an empty field has to be caught before the conversion,
  // otherwise clearing an input silently reads as zero instead of its default.
  if (input.value.trim() === "") return fallback;

  const value = Number(input.value);
  return Number.isFinite(value) ? value : fallback;
}

function percent(input) {
  return Math.min(1, Math.max(0, numberValue(input) / 100));
}

function currentState() {
  return {
    machinesPerYear: Math.max(0, numberValue(elements.machinesPerYear)),
    replacementsPerYear: Math.max(0, numberValue(elements.replacementsPerYear)),
    partPrice: Math.max(0, numberValue(elements.partPrice)),
    marginPercent: percent(elements.marginPercent),
    baseSteelVolume: Math.max(0, numberValue(elements.baseSteelVolume)),
    airxSteelVolume: Math.max(0, numberValue(elements.airxSteelVolume)),
    baseOilVolume: Math.max(0, numberValue(elements.baseOilVolume)),
    airxOilVolume: Math.max(0, numberValue(elements.airxOilVolume)),
    steelCostPerVolume: Math.max(0, numberValue(elements.steelCostPerVolume, 0.35)),
    oilCostPerGallon: Math.max(0, numberValue(elements.oilCostPerGallon, 20)),
    oilChangesPerMachineYear: Math.max(0, numberValue(elements.oilChangesPerMachineYear, 2)),
    forecastYears: Math.max(1, Math.round(numberValue(elements.forecastYears, 15))),
    machineLife: Math.max(1, Math.round(numberValue(elements.machineLife, 18))),
    baseShare: percent(elements.baseShare),
    protectedShare: percent(elements.protectedShare),

    // Optional per-tank cost lines. Each contributes nothing while its toggle
    // is off, so switching one off removes it from the totals rather than
    // counting it as zero.
    steelOn: elements.toggleSteel.checked,
    oilOn: elements.toggleOil.checked,
    complexityOn: elements.toggleComplexity.checked,
    flushingOn: elements.toggleFlushing.checked,
    filterOn: elements.toggleFilter.checked,
    baseComplexityCost: Math.max(0, numberValue(elements.baseComplexityCost)),
    airxComplexityCost: Math.max(0, numberValue(elements.airxComplexityCost)),
    baseFlushingCost: Math.max(0, numberValue(elements.baseFlushingCost)),
    airxFlushingCost: Math.max(0, numberValue(elements.airxFlushingCost)),
    baseFilterCost: Math.max(0, numberValue(elements.baseFilterCost))
  };
}

function savingsModel(state) {
  // Per-tank Baseline vs. Air-X comparison figures.
  // Steel and oil costs are always shown — switching a line off excludes it
  // from the totals, it does not pretend the steel is free.
  const baseSteelCost = state.baseSteelVolume * state.steelCostPerVolume;
  const airxSteelCost = state.airxSteelVolume * state.steelCostPerVolume;
  const baseOilCost = state.baseOilVolume * state.oilCostPerGallon;
  const airxOilCost = state.airxOilVolume * state.oilCostPerGallon;

  // What each line contributes to the totals.
  const baseSteelIncluded = state.steelOn ? baseSteelCost : 0;
  const airxSteelIncluded = state.steelOn ? airxSteelCost : 0;
  const baseOilIncluded = state.oilOn ? baseOilCost : 0;
  const airxOilIncluded = state.oilOn ? airxOilCost : 0;

  // Optional lines. An off toggle contributes 0 to both sides, so it drops out
  // of the totals entirely. The Air-X filter cost is not typed in — it is the
  // Selling Price per Filter from the parameters panel above.
  const baseComplexityCost = state.complexityOn ? state.baseComplexityCost : 0;
  const airxComplexityCost = state.complexityOn ? state.airxComplexityCost : 0;
  const baseFlushingCost = state.flushingOn ? state.baseFlushingCost : 0;
  const airxFlushingCost = state.flushingOn ? state.airxFlushingCost : 0;
  const baseFilterCost = state.filterOn ? state.baseFilterCost : 0;
  const airxFilterCost = state.filterOn ? state.partPrice : 0;

  const baseOptionalCost = baseComplexityCost + baseFlushingCost + baseFilterCost;
  const airxOptionalCost = airxComplexityCost + airxFlushingCost + airxFilterCost;

  const baseTotalCost = baseSteelIncluded + baseOilIncluded + baseOptionalCost;
  const airxTotalCost = airxSteelIncluded + airxOilIncluded + airxOptionalCost;
  // Weight counts only the lines that are switched on: no steel line, no steel
  // weight; no oil line, no oil weight.
  const baseTotalWeight =
    (state.steelOn ? state.baseSteelVolume * STEEL_DENSITY_LBS_PER_IN3 : 0) +
    (state.oilOn ? state.baseOilVolume * OIL_DENSITY_LBS_PER_GAL : 0);
  const airxTotalWeight =
    (state.steelOn ? state.airxSteelVolume * STEEL_DENSITY_LBS_PER_IN3 : 0) +
    (state.oilOn ? state.airxOilVolume * OIL_DENSITY_LBS_PER_GAL : 0);

  const compare = {
    baseSteelCost,
    airxSteelCost,
    baseOilCost,
    airxOilCost,
    baseComplexityCost,
    airxComplexityCost,
    baseFlushingCost,
    airxFlushingCost,
    baseFilterCost,
    airxFilterCost,
    baseOptionalCost,
    airxOptionalCost,
    baseTotalCost,
    airxTotalCost,
    baseTotalWeight,
    airxTotalWeight
  };

  // Gated at the source, so everything downstream of the oil line — CO₂, the
  // oil saving, the annual model — falls away together when it is switched off.
  const reducedGallons = state.oilOn ? Math.max(0, state.baseOilVolume - state.airxOilVolume) : 0;
  const reductionPercent = state.baseOilVolume > 0 ? reducedGallons / state.baseOilVolume : 0;

  // A line that is switched off claims no saving either, so the annual model
  // and the cost comparison never disagree about what is being counted.
  // Complexity, flushing and filter are per-tank build costs like the steel,
  // so their difference joins the tank-build saving that drives the Tank
  // Reduction Impact panel and the Tank and Oil Savings table.
  const optionalSavingPerMachine = baseOptionalCost - airxOptionalCost;
  const tankSavingPerMachine = baseSteelIncluded - airxSteelIncluded + optionalSavingPerMachine;
  const firstFillOilSavingPerMachine = state.oilOn ? reducedGallons * state.oilCostPerGallon : 0;
  const oilChangeSavingPerMachine = firstFillOilSavingPerMachine;
  const co2Reduction = reducedGallons * CO2_LBS_PER_GAL_OIL;

  // Total system cost saving per tank = steel saving + first-fill oil saving.
  const totalSystemCostSaving = baseTotalCost - airxTotalCost;

  return {
    ...compare,
    reducedGallons,
    reductionPercent,
    tankSavingPerMachine,
    firstFillOilSavingPerMachine,
    totalSystemCostSaving,
    oneTimeSavingPerMachine: totalSystemCostSaving,
    oilChangeSavingPerMachine,
    co2Reduction
  };
}

function calculateRows(state) {
  const savings = savingsModel(state);
  const rows = [];
  let cumulativeInitialSavings = 0;
  let cumulativeRevenue = 0;
  let cumulativeMargin = 0;

  for (let year = 1; year <= state.forecastYears; year += 1) {
    let installedBase = 0;
    let totalDemand = 0;
    let baseDemand = 0;
    let protectedDemand = 0;

    // age 0 = the cohort introduced this year, so year 1 already carries the initial
    // delivery; a cohort leaves the active fleet once age reaches machineLife.
    for (let cohortYear = 1; cohortYear <= year; cohortYear += 1) {
      const age = year - cohortYear;
      if (age >= state.machineLife) continue;

      const cohortDemand = state.machinesPerYear * state.replacementsPerYear;
      installedBase += state.machinesPerYear;
      totalDemand += cohortDemand;
      baseDemand += cohortDemand * state.baseShare;
      protectedDemand += cohortDemand * state.protectedShare;
    }

    const baseRevenue = baseDemand * state.partPrice;
    const protectedRevenue = protectedDemand * state.partPrice;

    // A new machine's factory fill covers its first interval, so in its delivery year
    // it takes one change fewer than the yearly rate (never fewer than zero).
    const newMachineFills = 1 + Math.max(0, state.oilChangesPerMachineYear - 1);
    const machinesInField = Math.max(0, installedBase - state.machinesPerYear);
    const oilFillsThisYear =
      state.machinesPerYear * newMachineFills + machinesInField * state.oilChangesPerMachineYear;

    // Tank savings: the tank build saving on the machines produced this year, plus
    // the oil saving on every fill happening this year (first fills and changes).
    const productionSavings = state.machinesPerYear * savings.tankSavingPerMachine;
    const oilChangeSavings = oilFillsThisYear * savings.oilChangeSavingPerMachine;
    const annualInitialSavings = productionSavings + oilChangeSavings;

    // CO₂ follows the oil actually saved, so it tracks every fill — not just first fills.
    const oilGallonsSaved = oilFillsThisYear * savings.reducedGallons;
    const co2Reduction = oilGallonsSaved * CO2_LBS_PER_GAL_OIL;

    cumulativeInitialSavings += annualInitialSavings;
    cumulativeRevenue += protectedRevenue;
    cumulativeMargin += protectedRevenue * state.marginPercent;

    rows.push({
      year,
      installedBase,
      totalDemand,
      baseRevenue,
      baseMargin: baseRevenue * state.marginPercent,
      protectedRevenue,
      protectedMargin: protectedRevenue * state.marginPercent,
      cumulativeRevenue,
      cumulativeMargin,
      deltaRevenue: Math.max(0, protectedRevenue - baseRevenue),
      deltaMargin: Math.max(0, (protectedRevenue - baseRevenue) * state.marginPercent),
      oilFills: oilFillsThisYear,
      productionSavings,
      oilChangeSavings,
      annualInitialSavings,
      cumulativeInitialSavings,
      oilGallonsSaved,
      co2Reduction
    });
  }

  return rows;
}

function formatCurrency(value) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0
  }).format(value);
}

// A switched-off line shows no figure at all. Zero would read as a real
// measurement; the placeholder says the line is not being counted.
const OFF_VALUE = "---";

function showValue(node, on, text) {
  node.textContent = on ? text : OFF_VALUE;
}

// Dim an optional row and disable its inputs while its toggle is off, so it
// reads as excluded rather than as a genuine zero.
function applyOptionalRow(name, on, inputs) {
  // Every row in the group dims together, so a volume row and the cost row
  // derived from it read as one excluded line item.
  document.querySelectorAll(`.optional-row[data-optional="${name}"]`)
    .forEach((row) => row.classList.toggle("is-off", !on));
  inputs.forEach((input) => { input.disabled = !on; });
}

// A switched-off row shows no reduction at all — "no change" would read as a
// finding when the truth is that the line is not counted.
function setOptionalReductionWith(node, on, baseValue, airxValue, format) {
  if (!on) {
    node.classList.remove("is-increase", "is-flat");
    node.textContent = "";
    return;
  }
  setReduction(node, baseValue, airxValue, format);
}

function setOptionalReduction(node, on, baseValue, airxValue) {
  setOptionalReductionWith(node, on, baseValue, airxValue, formatCurrency);
}

// Renders the Air-X reduction vs. the baseline as "−$42 (−29%)" beside the value.
function setReduction(node, baseValue, airxValue, format) {
  const delta = baseValue - airxValue;
  const share = baseValue > 0 ? (delta / baseValue) * 100 : 0;

  node.classList.remove("is-increase", "is-flat");

  if (Math.abs(delta) < 0.005) {
    node.classList.add("is-flat");
    node.textContent = "no change";
    return;
  }

  const sign = delta > 0 ? "−" : "+";
  if (delta < 0) {
    node.classList.add("is-increase");
  }
  node.textContent = `${sign}${format(Math.abs(delta))} (${sign}${Math.abs(Math.round(share))}%)`;
}

// Currency with an explicit + / − sign, for delta columns.
function formatSignedCurrency(value) {
  if (Math.abs(value) < 0.5) {
    return formatCurrency(0);
  }
  return `${value > 0 ? "+" : "−"}${formatCurrency(Math.abs(value))}`;
}

// Short y-axis ticks, so the labels stay clear of the axis title.
function formatAxisValue(value) {
  if (value >= 1000000) {
    const millions = value / 1000000;
    return `$${millions % 1 === 0 ? millions : millions.toFixed(1)}M`;
  }
  if (value >= 1000) {
    const thousands = value / 1000;
    return `$${thousands % 1 === 0 ? thousands : thousands.toFixed(1)}K`;
  }
  return formatCurrency(value);
}

// Round the axis up to a 1 / 2 / 2.5 / 5 x 10^n step, so every gridline lands on a
// readable number and a plotted point can be checked against the labels.
function niceAxisStep(dataMax, tickCount) {
  if (!(dataMax > 0)) return 1;

  const rough = dataMax / tickCount;
  const magnitude = 10 ** Math.floor(Math.log10(rough));
  const normalized = rough / magnitude;
  const nice = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 2.5 ? 2.5 : normalized <= 5 ? 5 : 10;

  return nice * magnitude;
}

function formatNumber(value) {
  return new Intl.NumberFormat("en-US", {
    maximumFractionDigits: 0
  }).format(value);
}

function totals(rows) {
  return rows.reduce(
    (sum, row) => {
      sum.baseRevenue += row.baseRevenue;
      sum.baseMargin += row.baseMargin;
      sum.revenue += row.protectedRevenue;
      sum.margin += row.protectedMargin;
      sum.deltaRevenue += row.deltaRevenue;
      sum.deltaMargin += row.deltaMargin;
      sum.initialSavings += row.annualInitialSavings;
      sum.tankSavings += row.productionSavings;
      sum.oilSavings += row.oilChangeSavings;
      sum.co2Reduction += row.co2Reduction;
      return sum;
    },
    {
      revenue: 0,
      margin: 0,
      deltaRevenue: 0,
      deltaMargin: 0,
      baseRevenue: 0,
      baseMargin: 0,
      initialSavings: 0,
      tankSavings: 0,
      oilSavings: 0,
      co2Reduction: 0
    }
  );
}

function drawLine(ctx, points, color, width = 3, dash = []) {
  ctx.save();
  ctx.strokeStyle = color;
  ctx.lineWidth = width;
  ctx.setLineDash(dash);
  ctx.lineJoin = "round";
  ctx.lineCap = "round";
  ctx.beginPath();
  points.forEach((point, index) => {
    if (index === 0) ctx.moveTo(point.x, point.y);
    else ctx.lineTo(point.x, point.y);
  });
  ctx.stroke();
  ctx.restore();
}

function drawDeltaArea(ctx, lowerPoints, upperPoints, color) {
  if (lowerPoints.length === 0 || upperPoints.length === 0) return;

  ctx.save();
  ctx.fillStyle = color;
  ctx.beginPath();
  upperPoints.forEach((point, index) => {
    if (index === 0) ctx.moveTo(point.x, point.y);
    else ctx.lineTo(point.x, point.y);
  });
  [...lowerPoints].reverse().forEach((point) => {
    ctx.lineTo(point.x, point.y);
  });
  ctx.closePath();
  ctx.fill();
  ctx.restore();
}

function drawChart(rows, state) {
  const canvas = elements.chart;
  const rect = canvas.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  // The drawing space has to stay 1:1 with the element's CSS box, otherwise the
  // hover maths (which measures the element) lands on the wrong year.
  const cssWidth = Math.max(320, Math.floor(rect.width) || 640);
  const cssHeight = Math.max(120, Math.floor(rect.height) || 140);
  canvas.width = cssWidth * dpr;
  canvas.height = cssHeight * dpr;

  const ctx = canvas.getContext("2d");
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

  const width = canvas.width / dpr;
  const height = canvas.height / dpr;
  ctx.clearRect(0, 0, width, height);

  const padding = { top: 20, right: 24, bottom: 56, left: 96 };
  const plotWidth = width - padding.left - padding.right;
  const plotHeight = height - padding.top - padding.bottom;
  const seriesValues = rows.flatMap((row) => [
    row.baseRevenue,
    row.baseMargin,
    row.annualInitialSavings,
    row.protectedRevenue,
    row.protectedMargin
  ]);
  const gridLines = 5;
  const stepValue = niceAxisStep(Math.max(1, ...seriesValues), gridLines);
  const maxValue = stepValue * gridLines;
  const stepX = rows.length > 1 ? plotWidth / (rows.length - 1) : plotWidth;

  function yScale(value) {
    return padding.top + plotHeight - (value / maxValue) * plotHeight;
  }

  function xScale(index) {
    return padding.left + (rows.length === 1 ? plotWidth / 2 : index * stepX);
  }

  ctx.fillStyle = "#ffffff";
  ctx.fillRect(0, 0, width, height);
  ctx.strokeStyle = "#d8e0df";
  ctx.lineWidth = 1;
  ctx.fillStyle = "#5f6c70";
  ctx.font = "700 12px Inter, system-ui, sans-serif";

  ctx.save();
  ctx.textAlign = "right";
  for (let i = 0; i <= gridLines; i += 1) {
    const value = stepValue * i;
    const y = yScale(value);
    ctx.beginPath();
    ctx.moveTo(padding.left, y);
    ctx.lineTo(width - padding.right, y);
    ctx.stroke();
    ctx.fillText(formatAxisValue(value), padding.left - 10, y + 4);
  }
  ctx.restore();

  ctx.strokeStyle = "#9eacab";
  ctx.beginPath();
  ctx.moveTo(padding.left, padding.top);
  ctx.lineTo(padding.left, height - padding.bottom);
  ctx.lineTo(width - padding.right, height - padding.bottom);
  ctx.stroke();

  const labelEvery = Math.max(1, Math.ceil(rows.length / 10));
  ctx.save();
  ctx.textAlign = "center";
  ctx.fillStyle = "#5f6c70";
  rows.forEach((row, index) => {
    if (index % labelEvery !== 0 && index !== rows.length - 1) return;
    ctx.fillText(String(row.year), xScale(index), height - padding.bottom + 20);
  });

  // Axis titles.
  ctx.font = "800 12px Inter, system-ui, sans-serif";
  ctx.fillText("Year", padding.left + plotWidth / 2, height - 12);
  ctx.translate(18, padding.top + plotHeight / 2);
  ctx.rotate(-Math.PI / 2);
  ctx.fillText("USD per Year", 0, 0);
  ctx.restore();

  const baseRevenuePoints = rows.map((row, index) => ({ x: xScale(index), y: yScale(row.baseRevenue) }));
  const protectedRevenuePoints = rows.map((row, index) => ({ x: xScale(index), y: yScale(row.protectedRevenue) }));
  const baseMarginPoints = rows.map((row, index) => ({ x: xScale(index), y: yScale(row.baseMargin) }));
  const protectedMarginPoints = rows.map((row, index) => ({ x: xScale(index), y: yScale(row.protectedMargin) }));
  const initialSavingsPoints = rows.map((row, index) => ({ x: xScale(index), y: yScale(row.annualInitialSavings) }));

  drawDeltaArea(ctx, baseRevenuePoints, protectedRevenuePoints, "rgba(213, 82, 70, 0.14)");

  // Margins are dotted and share the colour of the revenue line they belong to.
  drawLine(ctx, baseMarginPoints, chartColors.baseRevenue, 3, DOTTED_LINE);
  drawLine(ctx, protectedMarginPoints, chartColors.protectedRevenue, 3, DOTTED_LINE);

  drawLine(ctx, baseRevenuePoints, chartColors.baseRevenue, 3);
  drawLine(ctx, initialSavingsPoints, chartColors.initialSavings, 3, DASHED_LINE);

  drawLine(ctx, protectedRevenuePoints, chartColors.protectedRevenue, 3);

  // Remember the mapping so mouse moves can find the year under the cursor.
  chartGeometry = { padding, plotWidth, stepX, width, height, count: rows.length, xScale };

  if (chartHoverIndex !== null && rows[chartHoverIndex]) {
    const hoverX = xScale(chartHoverIndex);
    const hovered = rows[chartHoverIndex];

    ctx.save();
    ctx.strokeStyle = "rgba(23, 32, 34, 0.3)";
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(hoverX, padding.top);
    ctx.lineTo(hoverX, height - padding.bottom);
    ctx.stroke();
    ctx.restore();

    const markers = [
      [hovered.baseRevenue, chartColors.baseRevenue],
      [hovered.baseMargin, chartColors.baseRevenue],
      [hovered.annualInitialSavings, chartColors.initialSavings]
    ];
    markers.push([hovered.protectedRevenue, chartColors.protectedRevenue]);
    markers.push([hovered.protectedMargin, chartColors.protectedRevenue]);

    ctx.save();
    ctx.lineWidth = 2;
    ctx.strokeStyle = "#ffffff";
    markers.forEach(([value, color]) => {
      ctx.beginPath();
      ctx.arc(hoverX, yScale(value), 4.5, 0, Math.PI * 2);
      ctx.fillStyle = color;
      ctx.fill();
      ctx.stroke();
    });
    ctx.restore();
  }
}

// Nearest year to the pointer, or null when the pointer is outside the plot.
function chartIndexFromEvent(event) {
  if (!chartGeometry || chartGeometry.count === 0) return null;

  const rect = elements.chart.getBoundingClientRect();
  const x = event.clientX - rect.left;
  const { padding, stepX, count } = chartGeometry;

  if (x < padding.left - 24 || x > rect.width - padding.right + 24) return null;
  if (count === 1) return 0;

  const index = Math.round((x - padding.left) / stepX);
  return Math.min(count - 1, Math.max(0, index));
}

function tooltipRow(label, value, color, style = "") {
  return `
    <div class="tooltip-row">
      <span class="tooltip-key" style="color:${color}"><i class="${style}"></i>${label}</span>
      <strong>${value}</strong>
    </div>
  `;
}

function showChartTooltip(index) {
  const row = latestRows[index];
  if (!row) return;

  const rows = [
    tooltipRow("Revenue Without Protection", formatCurrency(row.baseRevenue), chartColors.baseRevenue),
    tooltipRow("Margin Without Protection", formatCurrency(row.baseMargin), chartColors.baseRevenue, "dotted")
  ];
  rows.push(
    tooltipRow("Revenue With Protection", formatCurrency(row.protectedRevenue), chartColors.protectedRevenue),
    tooltipRow("Margin With Protection", formatCurrency(row.protectedMargin), chartColors.protectedRevenue, "dotted")
  );
  rows.push(
    tooltipRow("Tank and Oil Savings", formatCurrency(row.annualInitialSavings), chartColors.initialSavings, "dashed")
  );

  // Running totals through this year, matching the Annual Overview columns.
  const cumulative = [
    ["Cumulative Revenue", row.cumulativeRevenue],
    ["Cumulative Margin", row.cumulativeMargin],
    ["Cumulative Savings", row.cumulativeInitialSavings]
  ]
    .map(
      ([label, value]) => `
      <div class="tooltip-row">
        <span class="tooltip-key">${label}</span>
        <strong>${formatCurrency(value)}</strong>
      </div>
    `
    )
    .join("");

  const tooltip = elements.chartTooltip;
  tooltip.innerHTML =
    `<p class="tooltip-year">Year ${row.year}</p>` +
    rows.join("") +
    `<div class="tooltip-cumulative">${cumulative}</div>`;
  tooltip.hidden = false;

  const wrapWidth = elements.chart.getBoundingClientRect().width;
  const pointX = chartGeometry.xScale(index);
  const tipWidth = tooltip.offsetWidth;
  const left = pointX + 16 + tipWidth > wrapWidth ? pointX - tipWidth - 16 : pointX + 16;
  tooltip.style.left = `${Math.max(4, Math.min(left, wrapWidth - tipWidth - 4))}px`;
}

function hideChartTooltip() {
  elements.chartTooltip.hidden = true;
}

function updateLegend() {
  const items = [
    ["Revenue Without Protection", chartColors.baseRevenue],
    ["Margin Without Protection", chartColors.baseRevenue, true],
    ["Revenue With Protection", chartColors.protectedRevenue],
    ["Margin With Protection", chartColors.protectedRevenue, true],
    ["Tank and Oil Savings - per Year", chartColors.initialSavings]
  ];


  elements.legend.innerHTML = items
    .map(
      ([label, color, dotted]) =>
        `<span style="color:${color}"><i class="${dotted ? "dotted" : ""}"></i>${label}</span>`
    )
    .join("");
}

function updateTable(rows) {
  elements.dataRows.innerHTML = rows
    .map((row) => {
      const protectedRevenue = formatCurrency(row.protectedRevenue);
      const protectedMargin = formatCurrency(row.protectedMargin);
      const deltaRevenue = formatSignedCurrency(row.deltaRevenue);
      const deltaMargin = formatSignedCurrency(row.deltaMargin);
      return `
        <tr>
          <td>Year ${row.year}</td>
          <td>${formatNumber(row.installedBase)}</td>
          <td>${formatNumber(row.totalDemand)}</td>
          <td>${formatCurrency(row.baseRevenue)}</td>
          <td>${formatCurrency(row.baseMargin)}</td>
          <td>${protectedRevenue}</td>
          <td class="col-with">${deltaRevenue}</td>
          <td class="col-with">${protectedMargin}</td>
          <td class="col-with">${deltaMargin}</td>
          <td>${formatCurrency(row.cumulativeRevenue)}</td>
          <td>${formatCurrency(row.cumulativeMargin)}</td>
        </tr>
      `;
    })
    .join("");
}

function updateSavingsTable(rows) {
  elements.savingsRows.innerHTML = rows
    .map(
      (row) => `
        <tr>
          <td>Year ${row.year}</td>
          <td>${formatNumber(row.installedBase)}</td>
          <td>${formatCurrency(row.productionSavings)}</td>
          <td>${formatNumber(row.oilFills)}</td>
          <td>${formatCurrency(row.oilChangeSavings)}</td>
          <td>${formatCurrency(row.annualInitialSavings)}</td>
          <td>${formatCurrency(row.cumulativeInitialSavings)}</td>
        </tr>
      `
    )
    .join("");
}

// Savings over the whole forecast: the baseline tank earns none, the Air-X tank
// splits its savings into the tank (build) share and the oil share.
function updateTankImpact(rows) {
  const tankSavings = rows.reduce((sum, row) => sum + row.productionSavings, 0);
  const oilSavings = rows.reduce((sum, row) => sum + row.oilChangeSavings, 0);
  const totalSavings = tankSavings + oilSavings;
  const maxSavings = Math.max(1, totalSavings);

  elements.tankBaseSavings.textContent = formatCurrency(0);
  elements.tankBaseBar.style.width = "0%";

  elements.tankTotalSavings.textContent = formatCurrency(totalSavings);
  elements.tankSavingsValue.textContent = formatCurrency(tankSavings);
  elements.oilSavingsValue.textContent = formatCurrency(oilSavings);
  elements.tankSavingsBar.style.width = `${(tankSavings / maxSavings) * 100}%`;
  elements.oilSavingsBar.style.width = `${(oilSavings / maxSavings) * 100}%`;
}

function updateImpact(total) {
  const baseRevenue = total.baseRevenue;
  const protectedRevenue = total.revenue;
  const deltaRevenue = total.deltaRevenue;
  const maxRevenue = Math.max(1, baseRevenue, protectedRevenue);

  elements.impactBaseRevenue.textContent = formatCurrency(baseRevenue);
  elements.impactProtectedRevenue.textContent = formatCurrency(protectedRevenue);
  elements.impactBaseBar.style.width = `${(baseRevenue / maxRevenue) * 100}%`;
  elements.impactProtectedBaseBar.style.width = `${(baseRevenue / maxRevenue) * 100}%`;
  elements.impactDeltaBar.style.width = `${(deltaRevenue / maxRevenue) * 100}%`;
  elements.impactBaseShareValue.textContent = formatCurrency(baseRevenue);
  elements.impactDeltaValue.textContent = formatCurrency(deltaRevenue);
}

function updateUi() {
  const state = currentState();
  const savings = savingsModel(state);
  latestRows = calculateRows(state);
  const total = totals(latestRows);

  // CO₂ comes from the oil line, so it goes blank with it.
  showValue(elements.co2Reduction, state.oilOn, `${formatNumber(savings.co2Reduction)} lbs CO₂`);

  showValue(elements.baseSteelCost, state.steelOn, formatCurrency(savings.baseSteelCost));
  showValue(elements.airxSteelCost, state.steelOn, formatCurrency(savings.airxSteelCost));
  showValue(elements.baseOilCost, state.oilOn, formatCurrency(savings.baseOilCost));
  showValue(elements.airxOilCost, state.oilOn, formatCurrency(savings.airxOilCost));
  elements.baseTotalCost.textContent = formatCurrency(savings.baseTotalCost);
  elements.airxTotalCost.textContent = formatCurrency(savings.airxTotalCost);
  elements.baseTotalWeight.textContent = `${formatNumber(savings.baseTotalWeight)} lbs`;
  elements.airxTotalWeight.textContent = `${formatNumber(savings.airxTotalWeight)} lbs`;

  // Tank system cost across one year of production.
  const baseFleetSystemCost = savings.baseTotalCost * state.machinesPerYear;
  const airxFleetSystemCost = savings.airxTotalCost * state.machinesPerYear;
  elements.baseFleetSystemCost.textContent = formatCurrency(baseFleetSystemCost);
  elements.airxFleetSystemCost.textContent = formatCurrency(airxFleetSystemCost);

  const inCubicInches = (value) => `${formatNumber(value)} in³`;
  const inGallons = (value) => `${formatNumber(value)} gal`;
  const inPounds = (value) => `${formatNumber(value)} lbs`;

  setOptionalReductionWith(elements.airxSteelVolumeDelta, state.steelOn, state.baseSteelVolume, state.airxSteelVolume, inCubicInches);
  setOptionalReductionWith(elements.airxSteelCostDelta, state.steelOn, savings.baseSteelCost, savings.airxSteelCost, formatCurrency);
  setOptionalReductionWith(elements.airxOilVolumeDelta, state.oilOn, state.baseOilVolume, state.airxOilVolume, inGallons);
  setOptionalReductionWith(elements.airxOilCostDelta, state.oilOn, savings.baseOilCost, savings.airxOilCost, formatCurrency);

  // Optional rows: the Air-X filter cost mirrors Selling Price per Filter.
  showValue(elements.airxFilterCost, state.filterOn, formatCurrency(savings.airxFilterCost));

  applyOptionalRow("Steel", state.steelOn, [elements.baseSteelVolume, elements.airxSteelVolume]);
  applyOptionalRow("Oil", state.oilOn, [elements.baseOilVolume, elements.airxOilVolume]);
  applyOptionalRow("Complexity", state.complexityOn, [elements.baseComplexityCost, elements.airxComplexityCost]);
  applyOptionalRow("Flushing", state.flushingOn, [elements.baseFlushingCost, elements.airxFlushingCost]);
  applyOptionalRow("Filter", state.filterOn, [elements.baseFilterCost]);

  setOptionalReduction(elements.airxComplexityCostDelta, state.complexityOn,
    savings.baseComplexityCost, savings.airxComplexityCost);
  setOptionalReduction(elements.airxFlushingCostDelta, state.flushingOn,
    savings.baseFlushingCost, savings.airxFlushingCost);
  setOptionalReduction(elements.airxFilterCostDelta, state.filterOn,
    savings.baseFilterCost, savings.airxFilterCost);

  setReduction(elements.airxTotalCostDelta, savings.baseTotalCost, savings.airxTotalCost, formatCurrency);
  setReduction(elements.airxTotalWeightDelta, savings.baseTotalWeight, savings.airxTotalWeight, inPounds);
  setReduction(elements.airxFleetSystemCostDelta, baseFleetSystemCost, airxFleetSystemCost, formatCurrency);
  // The CO₂ cell already shows the reduction itself, so annotate it with the
  // share only — and say nothing at all while the oil line is switched off.
  const co2Share = state.baseOilVolume > 0 ? savings.reducedGallons / state.baseOilVolume : 0;
  elements.co2ReductionDelta.classList.toggle("is-flat", state.oilOn && co2Share <= 0);
  elements.co2ReductionDelta.textContent = !state.oilOn
    ? ""
    : co2Share > 0 ? `−${Math.round(co2Share * 100)}% vs baseline` : "no change";



  elements.totalRevenue.textContent = formatCurrency(total.revenue);
  elements.totalMargin.textContent = formatCurrency(total.margin);
  elements.totalInitialSavings.textContent = formatCurrency(total.initialSavings);
  elements.deltaRevenue.textContent = `(${formatCurrency(total.deltaRevenue)} from Protection)`;
  elements.deltaMargin.textContent = `(${formatCurrency(total.deltaMargin)} from Protection)`;
  elements.totalCo2Reduction.textContent = `${formatNumber(total.co2Reduction)} lbs CO₂`;


  updateImpact(total);
  updateTankImpact(latestRows);
  updateLegend(state);
  updateTable(latestRows);
  updateSavingsTable(latestRows);
  drawChart(latestRows, state);
}

function csvValue(value) {
  return `"${String(value).replaceAll('"', '""')}"`;
}

// Mirrors the Annual Overview table, column for column.
function downloadCsv() {
  const header = [
    "Year",
    "Total Active Machines",
    "Annual Element Demand",
    "Revenue Without Protection",
    "Margin Without Protection",
    "Revenue With Protection",
    "Additional Revenue With Protection",
    "Margin With Protection",
    "Additional Margin With Protection",
    "Cumulative Revenue",
    "Cumulative Margin"
  ];
  const lines = latestRows.map((row) =>
    [
      row.year,
      row.installedBase,
      row.totalDemand,
      Math.round(row.baseRevenue),
      Math.round(row.baseMargin),
      Math.round(row.protectedRevenue),
      Math.round(row.deltaRevenue),
      Math.round(row.protectedMargin),
      Math.round(row.deltaMargin),
      Math.round(row.cumulativeRevenue),
      Math.round(row.cumulativeMargin)
    ]
      .map(csvValue)
      .join(",")
  );
  const csv = [header.map(csvValue).join(","), ...lines].join("\n");
  const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
  const link = document.createElement("a");
  link.href = URL.createObjectURL(blob);
  link.download = "annual-overview.csv";
  link.click();
  URL.revokeObjectURL(link.href);
}

document.querySelectorAll("input").forEach((input) => {
  input.addEventListener("input", updateUi);
  input.addEventListener("change", updateUi);
});

// Show / hide the two data tables behind a disclosure button.
document.querySelectorAll(".table-toggle").forEach((button) => {
  button.addEventListener("click", () => {
    const target = document.getElementById(button.getAttribute("aria-controls"));
    if (!target) return;
    const open = target.hidden;
    target.hidden = !open;
    button.setAttribute("aria-expanded", String(open));
    button.textContent = open ? button.dataset.hide : button.dataset.show;
  });
});
// Guarded so the export keeps working if the button is un-hidden, and the rest
// of the script still runs if it is ever deleted outright rather than hidden.
if (elements.downloadCsv) {
  elements.downloadCsv.addEventListener("click", downloadCsv);
}

// Resize only needs the chart re-measured, and only once per frame.
let resizeFrame = null;
window.addEventListener("resize", () => {
  if (resizeFrame !== null) return;
  resizeFrame = window.requestAnimationFrame(() => {
    resizeFrame = null;
    drawChart(latestRows, currentState());
  });
});

elements.chart.addEventListener("mousemove", (event) => {
  const index = chartIndexFromEvent(event);

  if (index === null) {
    if (chartHoverIndex !== null) {
      chartHoverIndex = null;
      drawChart(latestRows, currentState());
    }
    hideChartTooltip();
    return;
  }

  const state = currentState();
  if (index !== chartHoverIndex) {
    chartHoverIndex = index;
    drawChart(latestRows, state);
  }
  showChartTooltip(index);
});

elements.chart.addEventListener("mouseleave", () => {
  chartHoverIndex = null;
  hideChartTooltip();
  drawChart(latestRows, currentState());
});

updateUi();
  </script>
</Layout>
