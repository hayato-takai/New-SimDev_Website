---
import Layout from '../../layouts/BaseLayout.astro';
---

<!-- is:global, not scoped: the table rows, legend and chart tooltip are injected
     by the script at runtime, and Astro's scope attribute never reaches
     dynamically created nodes, so scoped rules would skip them entirely.
     Everything that could otherwise reach the site header or footer is
     namespaced under .vh-calc instead. -->
<style is:global>
.vh-calc {
  color-scheme: light;

  /* Surface names point at the shared /tools palette so this tool's existing
     rules pick up the unified look. The chart palette below stays local:
     those colours encode data series, not chrome. */
  --ink: var(--tool-ink);
  --muted: var(--tool-muted);
  --line: var(--tool-line);
  --surface: var(--tool-panel);
  --page: var(--tool-page-bg);
  --field-bg: var(--tool-field-bg);
  --field-line: var(--tool-line-strong);
  --field-focus: var(--tool-focus);
  --shadow: var(--tool-shadow);

  /* Data-series colours. */
  --teal: #00796b;
  --teal-dark: #00594f;
  --savings-green: #159464;
  --coral: #d55246;
  --gold: #b98210;
  --blue: #2f6fbd;
}
.vh-calc * {
  box-sizing: border-box;
}
/* Font, colour and page background now come from .tool-page, so every tool
   shares them. Only the minimum width is still this tool's own concern. */
.vh-calc {
  min-width: 320px;
}
.vh-calc button,
.vh-calc input {
  font: inherit;
}
/* Width and vertical padding come from .tool-shell. */
.vh-calc .toolbar,
.vh-calc .chart-panel,
.vh-calc .table-panel,
.vh-calc .impact-panel {
  background: var(--surface);
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
}
.vh-calc .toolbar {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18px;
  align-items: start;
  padding: 22px;
  border-radius: var(--tool-radius);
}
/* Parameters,
   tank reduction and forecast are each their own panel. */
.vh-calc .toolbar + .toolbar {
  margin-top: 18px;
}
.vh-calc .brand-block {
  display: flex;
  gap: 18px;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}
.vh-calc .eyebrow {
  margin: 0 0 6px;
  font-size: var(--tool-fs-base);
  font-weight: var(--tool-fw-bold);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--teal-dark);
}
.vh-calc h1,
.vh-calc h2 {
  margin: 0;
  letter-spacing: 0;
}
/* No max-width. The 520px cap was written when this title was 2rem, where the
   text needed ~449px and fit; at the shared 42px it needs ~590px and was being
   forced onto a second line. The header row is flex, so the title takes the
   width it needs and wraps only when the row genuinely runs out. */
.vh-calc h1 {
  font-size: var(--tool-fs-title);
  line-height: 1.08;
}
.vh-calc h2 {
  font-size: var(--tool-fs-lg);
  line-height: 1.2;
}
/* No max-width: the grid was capped at 980px inside a ~1056px panel, so each
   column came out ~233px while the longest label ("Filter Replacements per
   Machine/Year") needs ~243px. It wrapped, and its input dropped a line below
   the other three. Spanning the panel gives ~253px per column. */
.vh-calc .control-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(135px, 1fr));
  gap: 14px;
}

/* Between roughly 1120px and 1250px the columns are still too narrow for that
   label, so reserve two lines for every label in this grid. The inputs then
   line up whether a label wraps or not. */
.vh-calc .control-grid .field > span {
  min-height: 3.3em; /* two lines at the label's 1.65 line-height */
}
/* Lives in its own panel section,
   so it carries no frame or fill of its own. */
.vh-calc .savings-strip {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  align-items: stretch;
}
.vh-calc .savings-headline {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
  align-items: center;
}
/* The frame is an inset outline, not a border. A border sits outside the
   content box, so the table inside came out 2px narrower than the rate fields
   and the note beside it in the same card. An outline takes no layout space,
   and outline-offset:-1px draws it just inside the edge where it still follows
   the border-radius — same frame, table now exactly as wide as its siblings. */
.vh-calc .tank-compare-wrap {
  overflow-x: auto;
  outline: 1px solid var(--line);
  outline-offset: -1px;
  border-radius: var(--tool-radius);
  background: var(--surface);
}
.vh-calc table.tank-compare {
  width: 100%;
  min-width: 520px;
}
.vh-calc .tank-compare th,
.vh-calc .tank-compare td {
  border-bottom: 1px solid var(--line);
  vertical-align: middle;
}
.vh-calc .tank-compare thead th {
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
  /* 0.045 landed only 10 shades off white while the Air-X tint beside it is 24,
     so these cells read as unshaded next to it. 0.08 gives them weight without
     competing with the red. */
  background: rgba(23, 32, 34, 0.08);
}
/* Air-X column is called out in red; its values stay black and only the
   reduction text carries a colour. */
.vh-calc .tank-compare thead th.airx-col,
.vh-calc .tank-compare td.airx-col {
  background: rgba(213, 82, 70, 0.08);
}
.vh-calc .tank-compare thead th.airx-col {
  color: var(--coral);
  background: rgba(213, 82, 70, 0.13);
}
.vh-calc .tank-compare tbody td.airx-col {
  color: var(--ink);
}
.vh-calc .tank-compare tbody th {
  color: var(--muted);
  text-align: left;
  white-space: normal;
  line-height: 1.2;
}
.vh-calc .tank-compare tbody td {
  text-align: right;
}
.vh-calc .tank-compare tbody tr:hover {
  background: rgba(23, 32, 34, 0.035);
}
.vh-calc .tank-compare tr:last-child th,
.vh-calc .tank-compare tr:last-child td {
  border-bottom: 0;
}
.vh-calc .tank-compare tr.compare-total th,
.vh-calc .tank-compare tr.compare-total td {
  border-top: 1px solid var(--line);
  /* 0.045 landed only 10 shades off white while the Air-X tint beside it is 24,
     so these cells read as unshaded next to it. 0.08 gives them weight without
     competing with the red. */
  background: rgba(23, 32, 34, 0.08);
}
.vh-calc .tank-compare tr.compare-total td {
  font-weight: var(--tool-fw-bold);
}
.vh-calc .tank-compare tr.compare-total td.airx-col {
  background: rgba(213, 82, 70, 0.13);
}
.vh-calc .tank-compare tr.compare-co2 td.co2-value {
  color: var(--ink);
}
.vh-calc .tank-compare td.reference-cell {
  color: var(--muted);
}
.vh-calc .tank-compare .input-unit {
  width: min(150px, 100%);
  margin-left: auto;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
/* --blue is a chart series colour; hover matches .tool-page input:hover. */
.vh-calc .tank-compare .input-unit:hover {
  border-color: var(--tool-muted);
}
.vh-calc .tank-compare .input-unit input[type="number"] {
  /* .field input rules do not reach here, so size the control explicitly.
     min-width:0 keeps the 1fr grid track from pushing the unit label out. */
  width: 100%;
  min-width: 0;
  height: 34px;
  padding: 0 2px 0 10px;
  color: var(--ink);
  text-align: right;
  background: transparent;
}
/* Keep the native step arrows permanently visible,
   not only on hover. */
.vh-calc .tank-compare .input-unit input[type="number"]::-webkit-outer-spin-button,
.vh-calc .tank-compare .input-unit input[type="number"]::-webkit-inner-spin-button {
  margin-left: 4px;
  opacity: 1;
}
.vh-calc .tank-compare .input-unit > span {
  padding: 0 10px 0 2px;
  color: var(--muted);
  white-space: nowrap;
}
/* Air-X value plus its reduction vs. the baseline,
   side by side. */
.vh-calc .airx-cell {
  display: flex;
  gap: 10px;
  align-items: center;
  justify-content: flex-end;
}
.vh-calc .cell-delta {
  flex: 0 0 auto;
  min-width: 104px;
  font-size: var(--tool-fs-base);
  font-weight: var(--tool-fw-bold);
  white-space: nowrap;
  text-align: right;
  color: var(--savings-green);
}
.vh-calc .cell-delta.is-increase {
  color: var(--coral);
}
.vh-calc .cell-delta.is-flat {
  color: var(--muted);
}
.vh-calc .tank-rate-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(150px, 1fr));
  gap: 14px;
}
/* Disclosure button sits beside Export CSV in the panel head. */
.vh-calc .panel-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* Label plus its switch. space-between parks every toggle at the right edge of
   the label column, so they line up instead of stepping in and out with the
   length of each row's text. */
.vh-calc .tank-compare .row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

/* An optional row that is switched off is dimmed and its inputs disabled, so
   it reads as "not part of the totals" rather than "zero". The toggle itself
   stays at full strength — it is the way back. */
/* Opacity compounds with an ancestor's, so a switch inside a dimmed cell could
   never be brought back to full strength. Instead the cell is left alone and
   only its text span is dimmed — the switch is a sibling of that span, so it
   stays fully legible as the way back. */
.vh-calc .optional-row.is-off > td,
.vh-calc .optional-row.is-off.is-derived > th {
  opacity: 0.45;
}

.vh-calc .optional-row.is-off .row-head > span {
  opacity: 0.45;
}

.vh-calc .optional-row input:disabled {
  cursor: not-allowed;
}

.vh-calc .tank-compare-note {
  margin: 0;
  color: var(--muted);
  font-size: var(--tool-fs-base);
  line-height: 1.35;
}
.vh-calc .savings-copy {
  display: grid;
  gap: 8px;
}
.vh-calc .savings-copy strong {
  font-size: var(--tool-fs-lg);
}
.vh-calc .savings-title-row {
  display: flex;
  gap: 12px;
  align-items: baseline;
  flex-wrap: wrap;
}
.vh-calc .savings-title-row .eyebrow {
  margin: 0;
}
.vh-calc .field {
  display: grid;
  gap: 7px;
}
.vh-calc .field span,
.vh-calc .metric span {
  color: var(--muted);
  font-size: var(--tool-fs-base);
  font-weight: var(--tool-fw-bold);
}
.vh-calc .field input,
.vh-calc .input-unit {
  width: 100%;
}
/* .field input is the shared .tool-page control. */
/* The focus ring belongs on whatever draws the border: the bare input,
   or the
   .input-unit wrapper. Ringing the inner input clips it against the wrapper. */
.vh-calc .field > input:focus,
.vh-calc .input-unit:focus-within,
.vh-calc button:focus-visible {
  border-color: var(--tool-accent);
  outline: 3px solid var(--field-focus);
  outline-offset: 1px;
}
.vh-calc .input-unit input:focus {
  outline: none;
}
/* Same surface, border and radius as a bare control. This wrapper used to sit
   on --field-bg while the plain inputs beside it were on --surface, so half
   the controls in a row were tinted and half were white. */
.vh-calc .input-unit {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  border: 1px solid var(--field-line);
  border-radius: var(--tool-radius-sm);
  overflow: hidden;
  background: var(--surface);
}
.vh-calc .input-unit input {
  min-width: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.vh-calc .input-unit span {
  padding: 0 11px;
  color: var(--muted);
}
.vh-calc .content-grid {
  display: grid;
  gap: 18px;
  margin-top: 18px;
}
/* Grid items default to min-width:auto,
   so a wide table would stretch its panel
   past every other section. Let them shrink and scroll internally instead. */
.vh-calc .content-grid > *,
.vh-calc .savings-strip > *,
.vh-calc .table-wrap,
.vh-calc .tank-compare-wrap {
  min-width: 0;
}
.vh-calc .metric-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
}
.vh-calc .metric {
  display: grid;
  gap: 8px;
  min-height: 96px;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: var(--tool-radius);
  background: var(--surface);
  box-shadow: 0 8px 24px rgba(24, 40, 43, 0.06);
}
.vh-calc .metric strong {
  align-self: end;
  /* JetBrains Mono is loaded at 400/500 only, so the weight is capped at 500
     — anything heavier would be faux-bolded by the browser. */
  font-family: var(--font-mono);
  font-weight: var(--tool-fw-medium);
  font-size: var(--tool-fs-lg);
  line-height: 1.1;
}
/* Gain from protection,
   shown under the cumulative value it belongs to. */
.vh-calc .metric-delta {
  color: var(--savings-green);
  font-size: var(--tool-fs-base);
  font-style: normal;
  font-weight: var(--tool-fw-bold);
}
/* Metric values all read in ink; only the parenthetical line carries colour. */
.vh-calc .impact-panel {
  position: relative;
  display: grid;
  /* minmax(0, …) so both panels split the same way no matter how wide their
     copy or bar labels are — otherwise the bar tracks come out different widths. */
  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
  gap: 24px;
  overflow: hidden;
  border-radius: var(--tool-radius);
  padding: 22px;
  background: var(--surface);
}
/* Metric cards living inside an impact panel. */
.vh-calc .panel-metrics {
  position: relative;
  z-index: 1;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  margin-top: 18px;
}
.vh-calc .impact-copy,
.vh-calc .impact-bars,
.vh-calc .bar-row,
.vh-calc .bar-track {
  position: relative;
  z-index: 1;
  min-width: 0;
}
.vh-calc .impact-copy h2 {
  max-width: 520px;
  font-size: var(--tool-fs-lg);
  line-height: 1.18;
}
.vh-calc .impact-bars {
  display: grid;
  align-content: center;
  gap: 18px;
}
.vh-calc .bar-row {
  display: grid;
  gap: 8px;
}
.vh-calc .bar-label {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
}
.vh-calc .bar-label span {
  color: var(--muted);
  font-size: var(--tool-fs-base);
  font-weight: var(--tool-fw-bold);
}
.vh-calc .bar-label strong {
  font-size: var(--tool-fs-lg);
}
.vh-calc .bar-track {
  height: 32px;
  overflow: hidden;
  border: 1px solid rgba(23, 32, 34, 0.08);
  border-radius: 999px;
  background: rgba(126, 145, 148, 0.18);
}
.vh-calc .bar-track i,
.vh-calc .bar-track b {
  display: block;
  width: 0;
  height: 100%;
  background: var(--blue);
  transition: width 220ms ease;
}
.vh-calc .bar-track i {
  border-radius: inherit;
}
.vh-calc .protected .bar-track {
  display: flex;
  background: rgba(213, 82, 70, 0.14);
}
.vh-calc .protected .bar-track i {
  border-radius: 999px 0 0 999px;
  background: var(--blue);
}
.vh-calc .protected .bar-track b {
  border-radius: 0 999px 999px 0;
  background: linear-gradient(90deg, var(--coral), var(--gold));
}
/* Tank bars show savings only: the baseline earns none,
   Air-X splits tank vs oil. */
.vh-calc .savings-bar .bar-track {
  background: rgba(21, 148, 100, 0.14);
}
.vh-calc .savings-bar .bar-track i {
  background: var(--savings-green);
}
.vh-calc .savings-bar .bar-track b {
  background: var(--teal);
}
.vh-calc .bar-split-legend {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}
.vh-calc .bar-split-legend span {
  display: inline-flex;
  gap: 6px;
  align-items: center;
  color: var(--muted);
  font-size: var(--tool-fs-base);
  font-weight: var(--tool-fw-bold);
}
.vh-calc .bar-split-legend span::before {
  content: "";
  width: 10px;
  height: 10px;
  border-radius: 3px;
}
.vh-calc .bar-split-legend .key-tank::before {
  background: var(--savings-green);
}
.vh-calc .bar-split-legend .key-oil::before {
  background: var(--teal);
}
.vh-calc .bar-split-legend .key-base::before {
  background: var(--blue);
}
.vh-calc .bar-split-legend .key-delta::before {
  background: linear-gradient(90deg, var(--coral), var(--gold));
}
.vh-calc .bar-split-legend strong {
  color: var(--ink);
  font-size: var(--tool-fs-base);
}
.vh-calc .chart-panel,
.vh-calc .table-panel {
  border-radius: var(--tool-radius);
}
.vh-calc .panel-head {
  display: flex;
  gap: 16px;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}
.vh-calc .legend {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 14px;
  justify-content: flex-end;
}
.vh-calc .legend span {
  display: inline-flex;
  gap: 7px;
  align-items: center;
  color: var(--muted);
  font-size: var(--tool-fs-base);
  font-weight: var(--tool-fw-bold);
}
.vh-calc .legend i {
  width: 22px;
  height: 4px;
  border-radius: 999px;
  background: currentColor;
}
/* Matches the dotted margin lines in the chart. */
.vh-calc .legend i.dotted {
  border-radius: 0;
  background: radial-gradient(circle, currentColor 45%, transparent 50%) repeat-x;
  background-size: 7px 4px;
}
.vh-calc canvas {
  display: block;
  width: 100%;
  min-height: 120px;
}
.vh-calc .chart-canvas-wrap {
  position: relative;
}
.vh-calc .chart-canvas-wrap canvas {
  cursor: crosshair;
}
.vh-calc .chart-tooltip {
  position: absolute;
  top: 12px;
  z-index: 3;
  min-width: 210px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: var(--tool-radius);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 12px 28px rgba(24, 40, 43, 0.14);
  font-size: var(--tool-fs-base);
  pointer-events: none;
}
.vh-calc .chart-tooltip .tooltip-year {
  margin: 0 0 8px;
  font-size: var(--tool-fs-base);
  font-weight: var(--tool-fw-bold);
}
.vh-calc .chart-tooltip .tooltip-row {
  display: flex;
  gap: 14px;
  align-items: center;
  justify-content: space-between;
  margin-top: 3px;
}
.vh-calc .chart-tooltip .tooltip-key {
  display: inline-flex;
  gap: 7px;
  align-items: center;
  color: var(--muted);
  font-weight: var(--tool-fw-bold);
}
.vh-calc .chart-tooltip .tooltip-key i {
  width: 12px;
  height: 3px;
  border-radius: 2px;
  background: currentColor;
}
.vh-calc .chart-tooltip .tooltip-key i.dotted {
  background: radial-gradient(circle, currentColor 45%, transparent 50%) repeat-x;
  background-size: 5px 3px;
}
.vh-calc .chart-tooltip .tooltip-key i.dashed {
  background: linear-gradient(90deg, currentColor 60%, transparent 60%) repeat-x;
  background-size: 6px 3px;
}
.vh-calc .chart-tooltip strong {
  font-size: var(--tool-fs-base);
  white-space: nowrap;
}
.vh-calc .chart-tooltip .tooltip-cumulative {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--line);
}
/* Buttons are styled by .tool-page button in tools.css, so Export CSV here
   matches the buttons on every other tool page. */
.vh-calc .table-wrap {
  overflow-x: auto;
}
.vh-calc table {
  width: 100%;
  min-width: 1500px;
  border-collapse: collapse;
}
.vh-calc table.savings-table {
  min-width: 780px;
}
.vh-calc th,
.vh-calc td {
  border-bottom: 1px solid var(--line);
  text-align: right;
  white-space: nowrap;
}
.vh-calc th:first-child,
.vh-calc td:first-child {
  text-align: left;
}
.vh-calc tbody tr:hover {
  background: rgba(0, 121, 107, 0.06);
}
/* Annual Overview: only the words "Without" / "With" are coloured in the headers. */
.vh-calc .hl-without {
  color: var(--coral);
}
.vh-calc .hl-with {
  color: var(--savings-green);
}
.vh-calc .col-with {
  color: var(--savings-green);
}
@media (max-width: 1120px) {
.vh-calc .toolbar {
    grid-template-columns: 1fr;
  }
.vh-calc .control-grid {
    grid-template-columns: repeat(2, minmax(160px, 1fr));
  }

}
@media (max-width: 780px) {
.vh-calc .toolbar,
.vh-calc .chart-panel,
.vh-calc .table-panel {
    padding: 14px;
  }
.vh-calc .control-grid,
.vh-calc .metric-row,
.vh-calc .savings-strip,
.vh-calc .impact-panel {
    grid-template-columns: 1fr;
  }
.vh-calc h1 {
    font-size: var(--tool-fs-title);
  }
.vh-calc .metric strong {
    font-size: var(--tool-fs-lg);
  }
.vh-calc .savings-title-row {
    align-items: flex-start;
    flex-direction: column;
  }
.vh-calc .savings-headline,
.vh-calc .tank-rate-row {
    grid-template-columns: 1fr;
  }
.vh-calc .panel-head {
    align-items: flex-start;
    flex-direction: column;
  }
.vh-calc .legend {
    justify-content: flex-start;
  }

}
.vh-calc table th {
  white-space: normal;
  line-height: 1.2;
}
.vh-calc .toolbar-logo {
  flex: 0 0 auto;
  display: block;
  width: auto;
  height: 44px;
}


    </style>

<Layout title="Value Hypothesis Calculator">
  <main class="vh-calc tool-page">
    <div class="tool-shell">

      <header class="tool-header">
        <div class="tool-header-row brand-block">
          <h1>Value Hypothesis Calculator</h1>
          <svg class="toolbar-logo" viewBox="0 0 214 50" role="img" aria-label="HYDAC" xmlns="http://www.w3.org/2000/svg">
          <g id="CD/Logo/OG" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
