---
import Layout from '../../layouts/BaseLayout.astro';
import '../../styles/oil_properties.css';
const BASE_PATH = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Oil Property Search">

<main class="tool-page">
  <div class="tool-shell">

    <header class="tool-header">
      <div class="tool-header-row">
        <h1>Oil Property Search</h1>
        <a
          class="btn-docs"
          href={`${BASE_PATH}/helpers/documentation?readme=${BASE_PATH}/scripts/oil_properties/README.md`}
          target="_blank"
          rel="noopener noreferrer"
        >Documentation</a>
      </div>
      <p class="tool-subtitle">
        Look up density, kinematic and dynamic viscosity for a hydraulic fluid
        across a temperature range, with thermal expansion for a given volume.
      </p>
    </header>

    <div class="tool-card content">

    <!-- Fluid Selector & Temperature Range -->
    <div class="input-panel">
      <div class="input-row">
        <div class="input-group">
          <label for="fluidSelect">Select Fluid:</label>
          <select id="fluidSelect">
            <option value="">-- Select --</option>
          </select>
        </div>
        <div class="input-group">
          <label>Temperature <span class="optional">(optional)</span>:</label>
          <div class="temp-range-row">
            <input type="number" id="tempMin" placeholder="Min" step="1" />
            <span class="range-separator">to</span>
            <input type="number" id="tempMax" placeholder="Max" step="1" />
            <select id="inputTempUnitSelect" class="prop-unit-select">
              <option value="C">°C</option>
              <option value="K">K</option>
              <option value="F">°F</option>
            </select>
          </div>
          <small class="input-hint">Enter one value for a single point, two for a range, or leave empty for full range</small>
        </div>
        <div class="input-group">
          <label>Base Volume <span class="optional">(optional)</span>:</label>
          <div class="temp-range-row">
            <input type="number" id="baseVolume" placeholder="e.g. 100" step="any" min="0" />
            <select id="volumeInputUnitSelect" class="prop-unit-select">
              <option value="L">L</option>
              <option value="m^3">m³</option>
              <option value="gal">gal (US)</option>
            </select>
          </div>
          <small class="input-hint">Enter a volume to calculate mass and volume change</small>
        </div>
      </div>
    </div>

    <!-- Calculated Properties -->
    <div id="properties">

      <!-- Info Cards -->
      <div class="info-cards">
        <div class="info-card">
          <span class="info-label">Volume Change (ΔV/V)</span>
          <span class="info-value" id="thermalExpansion">---</span>
          <span class="info-unit"></span>
        </div>
        <div class="info-card" id="massCard">
          <span class="info-label">Mass</span>
          <div class="info-value-row">
            <span class="info-value" id="massValue">---</span>
            <select id="massOutputUnitSelect" class="prop-unit-select">
              <option value="kg">kg</option>
              <option value="g">g</option>
              <option value="lb">lb</option>
            </select>
          </div>
        </div>
        <div class="info-card" id="volChangeCard">
          <span class="info-label">Thermal Expansion (ΔV)</span>
          <div class="info-value-row">
            <span class="info-value" id="volChangeValue">---</span>
            <select id="volOutputUnitSelect" class="prop-unit-select">
              <option value="L">L</option>
              <option value="m^3">m³</option>
              <option value="gal">gal (US)</option>
            </select>
          </div>
        </div>
      </div>

      <h3>Calculated Properties</h3>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>
                <div class="prop-header-container">
                  <span>Temperature</span>
                  <select id="tempUnitSelect" class="prop-unit-select">
                    <option value="K">K</option>
                    <option value="C">°C</option>
                    <option value="F">°F</option>
                  </select>
                </div>
              </th>
              <th>
                <div class="prop-header-container">
                  <span>Kinematic Viscosity</span>
                  <select id="kinViscUnitSelect" class="prop-unit-select"></select>
                  <button class="copy-col-btn" data-col="1" title="Copy Temperature & Kinematic Viscosity">Copy</button>
                </div>
              </th>
              <th>
                <div class="prop-header-container">
                  <span>Density</span>
                  <select id="densityUnitSelect" class="prop-unit-select"></select>
                  <button class="copy-col-btn" data-col="2" title="Copy Temperature & Density">Copy</button>
                </div>
              </th>
              <th>
                <div class="prop-header-container">
                  <span>Dynamic Viscosity</span>
                  <select id="dynViscUnitSelect" class="prop-unit-select"></select>
                  <button class="copy-col-btn" data-col="3" title="Copy Temperature & Dynamic Viscosity">Copy</button>
                </div>
              </th>
            </tr>
          </thead>
          <tbody id="calculatedTableBody"></tbody>
        </table>
      </div>


    </div>
    </div>
  </main>

  <script define:vars={{ BASE_PATH }}>
    window.BASE_URL = BASE_PATH;

    // Stop the wheel from silently changing a focused select / number input.
    document.addEventListener('wheel', function (e) {
      const el = e.target;
      if (el.tagName === 'SELECT' || (el.tagName === 'INPUT' && el.type === 'number')) {
        el.blur();
      }
    }, { passive: true });
  </script>

  <script is:inline src={`${BASE_PATH}/scripts/unit_converter.js`}></script>
  <script is:inline src={`${BASE_PATH}/scripts/oil_properties/getOilProperties.js`}></script>
  <script is:inline src={`${BASE_PATH}/scripts/oil_properties/oil_properties.js`}></script>
</Layout>

<style>
  .input-panel {
    margin: 20px 0;
  }

  .input-row {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
    min-width: 220px;
  }

  .temp-range-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .temp-range-row input {
    flex: 1;
    min-width: 100px;
  }

  .range-separator {
    font-weight: var(--tool-fw-semibold);
    opacity: 0.7;
  }

  .optional {
    font-weight: var(--tool-fw-regular);
    font-size: var(--tool-fs-base);
    opacity: 0.7;
  }

  .input-hint {
    font-size: var(--tool-fs-base);
    opacity: 0.7;
    font-style: italic;
  }

  /* Quiet button; colours come from .tool-page .copy-col-btn in tools.css.
     min-width holds the label's width so the header doesn't shift when the
     text swaps to "Copied" on click. */
  .copy-col-btn {
    min-height: 0;
    min-width: 4.5em;
    font-size: var(--tool-fs-base);
    padding: 3px 8px;
    margin: 0;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .copy-col-btn:hover {
    opacity: 1;
  }

  .copy-col-btn.copied {
    opacity: 1;
    border-color: var(--success-color);
  }

  .prop-header-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .prop-unit-select {
    border: 1px solid #ccc;
    border-radius: 8px;
    background: var(--table-header, #f5f5f5);
    color: var(--text-primary, inherit);
    cursor: pointer;
  }

  .info-cards {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .info-card {
    flex: 1;
    min-width: 160px;
    padding: 12px 16px;
    border: 1px solid #ccc;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .info-label {
    font-size: var(--tool-fs-sm);
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .info-value {
    font-size: var(--tool-fs-lg);
    font-family: var(--font-mono);
    font-weight: var(--tool-fw-medium);
  }

  .info-unit {
    font-size: var(--tool-fs-sm);
    opacity: 0.6;
  }

  .info-value-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .info-value-row .prop-unit-select {
  }
</style>
